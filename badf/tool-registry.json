{
  "schema_version": "1.0.0",
  "default_policy": "deny-mutation",
  "tools": [
    {
      "id": "local-filesystem",
      "owner": "engineering_owner",
      "purpose": "Read and modify work-package-scoped repository files",
      "operations": ["READ", "WRITE"],
      "environments": ["development"],
      "approval_mode": "work-package",
      "credential_source": "none",
      "evidence": ["path", "diff", "validation-result"],
      "status": "ACTIVE"
    },
    {
      "id": "local-shell",
      "owner": "engineering_owner",
      "purpose": "Run bounded development and verification commands",
      "operations": ["READ", "WRITE"],
      "environments": ["development", "ci"],
      "approval_mode": "sandbox-and-work-package",
      "credential_source": "approved-environment-only",
      "evidence": ["command", "exit-code", "sanitized-output"],
      "status": "ACTIVE"
    }
  ]
}

