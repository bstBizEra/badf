        "KPI-001"
      ]
    },
    {
      "id": "OBJ-002",
      "statement": "No work package without a demand record.",
      "metric_refs": [
        "KPI-002"
      ]
    }
  ],
  "scope": {
    "in_scope": [
      "gate validation",
      "evidence binding",
      "authority floors"
