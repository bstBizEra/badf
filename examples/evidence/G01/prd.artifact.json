      "operators",
      "reviewers"
    ],
    "current_limitations": [
      "no evidence binding",
      "no authority separation"
    ],
    "business_impact": [
      "unreviewable change",
      "silent policy drift"
    ],
    "why_now": "agents now ship code unattended"
  },
  "target_users": [
    {
      "segment": "platform teams",
      "role": "operator",
      "needs": [
        "fail-closed gates"
      ],
      "pain_points": [
        "green tests that measure nothing"
      ]
    }
  ],
  "value_proposition": {
    "statement": "A run is measured by its side effects, never by its own account of itself.",
    "benefits": [
      "auditability",
      "reversibility"
    ]
  },
  "vision": "Every material change carries its authority and its evidence.",
  "objectives": [
    {
