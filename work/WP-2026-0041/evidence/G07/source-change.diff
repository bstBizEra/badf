+    "requirements": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "required": [
+          "id",
+          "statement",
+          "priority",
+          "testable",
+          "objective_refs"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "id": {
+            "type": "string",
+            "pattern": "^REQ-[0-9]{3,}$"
+          },
+          "statement": {
+            "type": "string",
+            "minLength": 1
+          },
+          "priority": {
+            "type": "string",
+            "enum": [
+              "Must Have",
+              "Should Have",
+              "Could Have",
+              "Won't Have"
+            ]
+          },
+          "testable": {
+            "type": "boolean"
+          },
+          "objective_refs": {
+            "type": "array",
+            "items": {
+              "type": "string",
+              "pattern": "^OBJ-[0-9]{3,}$"
+            }
+          }
+        }
+      }
+    }
+  }
+}
