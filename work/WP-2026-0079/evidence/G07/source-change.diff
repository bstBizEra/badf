+            if r.returncode:
+                raise ValidationError(f"cannot exclude work/{wp}/ and the lockfile from {rev}: {r.stderr.strip()}")
+        r = run("write-tree")
+        if r.returncode:
+            raise ValidationError(f"cannot write the content tree of {rev} in {checkout}: {r.stderr.strip()}")
+        return r.stdout.strip()
