+        r = run("read-tree", rev)
+        if r.returncode:
+            raise ValidationError(f"cannot read the tree of {rev} in {checkout}: {r.stderr.strip()}")
+        listed = run("ls-files", "--", f"work/{wp}", "badf/lockfile.json").stdout.split()
+        if listed:
