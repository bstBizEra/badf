+        "source_ref": branch,
+        "source_head_sha": head,
+        "source_tree": _git_at(root, "rev-parse", "HEAD^{tree}"),
+        "merge_base_sha": _git_at(root, "merge-base", "HEAD", target),
+        "ahead": ahead,
+        "behind": behind,
+        "head_is_ancestor_of_target": ancestor,
