+        try:
+            epoch = load_json(life).get("policy_epoch")
+        except ValidationError:
+            epoch = None
+    return {
+        "record": "git-baseline",
+        "schema_version": "1.0.0",
+        "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "disposition": "GIT_BASELINED",
+        "repository": {"name": name, "root": top},
