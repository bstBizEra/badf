+          "id": {"type": "string", "pattern": "^T-[0-9]{3,}$"},
+          "category": {"type": "string", "enum": ["SPOOFING", "TAMPERING", "REPUDIATION", "INFO_DISCLOSURE", "DENIAL_OF_SERVICE", "ELEVATION_OF_PRIVILEGE", "ABUSE_CASE", "AI_SAFETY"]},
+          "statement": {"type": "string", "minLength": 1},
+          "mitigation": {"type": "string"},
+          "residual_risk": {"type": "string"}
+        }
+      }
+    }
+  }
+}
