+
+    def _evidence(self, kind, artifact_text, binding, producer_type="controller", outcome="PASS"):
+        tmp = Path(tempfile.mkdtemp(prefix="badf-g08-rule-")); self.addCleanup(shutil.rmtree, tmp, True)
