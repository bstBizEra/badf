+class ReservationTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.framework = self.repo('framework')
+        self.target = self.repo('target')
+        self.token = str(uuid.uuid4())
+
+    def repo(self, name):
+        path = self.root/name
+        path.mkdir()
+        git(path, 'init', '-q')
+        (path/'badf').mkdir()
+        (path/'badf/work-registry.json').write_bytes(b'{"protected":true}\n')
+        git(path,'add','badf/work-registry.json')
+        git(path, '-c', 'user.name=Test', '-c', 'user.email=test@example.invalid',
+            'commit', '--allow-empty', '-qm', 'baseline')
+        return path
