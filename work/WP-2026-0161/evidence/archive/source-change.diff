+    def test_failures_at_each_write_boundary_hold_reservation(self):
+        # Exercise actual file create/replace seams, one fresh intake per effect.
+        values = self.allocation_args()
+        effects = gate.prepare_init(self.proj, api.load_allocation(values[2],
+            expected=gate._current_init_bindings(self.proj, values[1],
+                json.loads(values[2].read_bytes())['payload']['checkout']),
+            schema_check=gate.check_schema), now=self.now).expected_effects
+        for index, effect in enumerate(effects):
+            with self.subTest(boundary=index, path=effect['path']):
+                if index:
+                    self.doCleanups(); self.setUp(); values = self.allocation_args()
+                scope, rel = effect['path'].split(':', 1)
+                destination = (self.target if scope == 'target' else self.framework)/rel
+                original_open, original_replace = Path.open, os.replace
+                hit = []
+                def fail_open(path, mode='r', *args, **kwargs):
+                    receipt = rel.startswith('badf/evidence/receipts/') and scope == 'target'
+                    matches = path == destination or (receipt and path.parent == destination.parent)
+                    if matches and mode == 'xb':
+                        hit.append(str(path)); raise OSError('write boundary refusal')
+                    return original_open(path, mode, *args, **kwargs)
+                def fail_replace(source, target):
+                    if Path(target) == destination:
+                        hit.append(str(target)); raise OSError('write boundary refusal')
+                    return original_replace(source, target)
+                protected = (self.target/'AGENTS.md').read_bytes()
+                with patch.object(Path, 'open', fail_open), patch.object(os, 'replace', fail_replace):
+                    with self.assertRaisesRegex(gate.ValidationError, 'write boundary refusal'):
