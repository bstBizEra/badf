+    texts=dict(ledger='WP-2026-0110 BADF-DEM-0097 GOV-0097',branches='none',pr_files='none',bodies='discussion '+wp,comments='CLAIM '+wp)
+    surfaces={}
+    for name,txt in texts.items():
+        a,d=put(name+'.txt',txt)
+        receipt={'pages':[{'resource':name+'/1','outcome':'PASS','next':None,'artifact':a,'digest':d,'captured_at':t}],'complete':True}
+        ga,gd=put(name+'-gather.json',receipt)
+        surfaces[name]={'artifact':a,'digest':d,'gather':dict(outcome='PASS',pages=[name+'/1'],complete=True,completed_at=t,artifact=ga,digest=gd)}
+    report=sweep.render(sweep.scan(texts),{n:f'READ ({sum(len(rx.findall(txt)) for rx in sweep.FAMILIES.values())} id occurrence(s))' for n,txt in texts.items()})+'\n'
+    ra,rd=put('report.txt',report)
+    raw=dict(id=123,user={'login':'channel-account'},created_at=t,updated_at=t,html_url='https://github.com/bstBizEra/badf/issues/365#issuecomment-123',body='CLAIM '+wp)
+    ca,cd=put('claim.json',raw);wa,wd=put('worktrees.txt','worktree /synthetic\nHEAD '+('a'*40)+'\nbranch refs/heads/main\n\n');sa,sd=put('seat.json',dict(principal='builder',principal_type='agent',claims=[]))
+    ia,idg=put('controller.txt','synthetic executing input')
+    p=dict(work_package=wp,framework=dict(repository='bstBizEra/badf',revision='a'*40,inputs=[dict(path=ia,digest=idg)]),target=dict(repository='owner/target',baseline_commit='b'*40,status_digest=digest(b''),agents_digest=None),demand=dict(id='BADF-DEM-0147',digest=digest(b'demand')),claimant=dict(principal='builder',principal_type='agent'),claim=dict(url=raw['html_url'],comment_id=123,account='channel-account',created_at=t,updated_at=t,artifact=ca,digest=cd,acquisition=dict(operation='READ',repository='bstBizEra/badf',resource='repos/bstBizEra/badf/issues/comments/123',captured_at=t,outcome='PASS')),sweep=dict(captured_at=t,surfaces=surfaces,report=ra,report_digest=rd),checkout=dict(common_directory='/synthetic/common',worktrees_artifact=wa,worktrees_digest=wd,captured_at=t),seats=[dict(principal='builder',principal_type='agent',response_artifact=sa,response_digest=sd,claims=[])],non_coverage=['independent clones','remote freshness/acquisition trust','allocation review versus authorization'])
+    def save():
+        pd=digest(canonical(p));decision=dict(by='reviewer',principal_type='human',decision='ACCEPT',reviewed_payload_digest=pd,work_package=wp,claim=p['claim'],channel_verification=dict(outcome='PASS',method='approved-channel-review',claim_url=p['claim']['url'],account=p['claim']['account'],acquisition_resource=p['claim']['acquisition']['resource']),roster_complete=True,seats=p['seats'],occurrences=[dict(surface=n,offset=txt.index(wp),disposition='CLAIMANT' if n=='comments' else 'MENTION') for n,txt in texts.items() if wp in txt])
+        da,dd=put('review.json',decision)
+        envelope=dict(schema_version='1.0.0',payload=p,review=dict(by='reviewer',principal_type='human',decision='ACCEPT',reviewed_payload_digest=pd,decided_at=t,artifact=da,digest=dd));(root/'allocation.json').write_bytes(canonical(envelope));return root/'allocation.json'
