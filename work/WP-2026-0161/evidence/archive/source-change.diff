+import json, tempfile, unittest
+from pathlib import Path
+from scripts.badf_init_allocation import load_allocation, InitAllocationError
+from scripts.badf_gate import check_schema
+from tests._init_allocation import fixture, digest
+
+class AllocationTests(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.p, self.expected, self.save, self.put = fixture(self.root)
+
+    def load(self):
+        return load_allocation(self.save(), expected=self.expected, schema_check=check_schema)
+
+    def refuse(self, label):
+        path = self.save()
+        before = {p.name: p.read_bytes() for p in self.root.iterdir()}
+        with self.assertRaisesRegex(InitAllocationError, label):
+            load_allocation(path, expected=self.expected, schema_check=check_schema)
+        self.assertEqual(before, {p.name: p.read_bytes() for p in self.root.iterdir()})
+
+    def test_valid_synthetic_consistency(self):
+        self.assertIsNotNone(self.load(), 'allocation behavior absent')
+
+    def test_requires_all_five_readable_surfaces(self):
+        for n in self.p['sweep']['surfaces']:
+            with self.subTest(n=n):
+                path = self.root / (n + '.txt')
+                old = path.read_bytes()
+                path.write_bytes(b'')
+                self.refuse(n)
+                path.write_bytes(old)
+
+    def surface(self, n, txt):
+        a, d = self.put(n + '.txt', txt)
+        surf = self.p['sweep']['surfaces'][n]
+        surf['digest'] = d
+        receipt = json.loads((self.root / surf['gather']['artifact']).read_bytes())
+        receipt['pages'][0]['digest'] = d
+        a, d = self.put(surf['gather']['artifact'], receipt)
+        surf['gather']['digest'] = d
+
+    def test_missing_anchor_refuses(self):
+        self.surface('ledger', 'none')
+        self.refuse('anchor')
+
+    def test_remote_branch_and_pr_collision_refuse(self):
+        for n in ('branches', 'pr_files'):
+            with self.subTest(n=n):
+                self.surface(n, 'WP-2026-0161')
+                self.refuse(n)
+                self.surface(n, 'none')
+
+    def test_prose_is_not_automatically_a_claim(self):
+        self.assertIsNotNone(self.load(), 'allocation behavior absent')
+
+    def test_comment_occurrences_require_exact_reconciliation(self):
+        path = self.save()
+        v = json.loads((self.root / 'review.json').read_bytes())
+        v['occurrences'] = []
+        a, d = self.put('review.json', v)
+        e = json.loads(path.read_bytes())
+        e['review']['digest'] = d
+        path.write_text(json.dumps(e))
+        with self.assertRaisesRegex(InitAllocationError, 'occurrence'):
+            load_allocation(path, expected=self.expected, schema_check=check_schema)
+
+    def test_incomplete_gather_refuses(self):
+        self.p['sweep']['surfaces']['comments']['gather']['complete'] = False
+        self.refuse('comments')
+
+    def test_raw_claim_account_must_match(self):
+        self.p['claim']['account'] = 'forged'
+        self.refuse('claim')
+
+    def test_failed_claim_acquisition_refuses(self):
+        self.p['claim']['acquisition']['outcome'] = 'FAIL'
+        self.refuse('claim|schema')
+
+    def test_all_bindings_and_safe_paths_are_checked(self):
+        for bad in ('../escape', '/absolute', 'C:/drive', '\\\\server\\share'):
+            with self.subTest(path=bad):
+                self.p['claim']['artifact'] = bad
+                self.refuse('path|claim')
+        self.p['claim']['artifact'] = 'claim.json'
+        self.expected['target'] = dict(self.expected['target'], baseline_commit='c' * 40)
+        self.refuse('target')
+
+    def test_exact_sentinel_exclusions(self):
+        for n in ('0997', '0998', '0999', '9999'):
+            with self.subTest(n=n):
+                self.p['work_package'] = 'WP-2026-' + n
+                self.refuse('sentinel|work_package|schema')
+
+    def test_invalid_claim_artifact_and_symlink_escape(self):
+        self.p['claim']['artifact'] = 'ledger.txt'
+        self.p['claim']['digest'] = self.p['sweep']['surfaces']['ledger']['digest']
+        self.refuse('claim')
+        self.p['claim']['artifact'] = 'claim.json'
+        outside = self.root.parent / (self.root.name + '-outside')
+        outside.write_text('{}')
+        self.addCleanup(outside.unlink)
+        (self.root / 'escape').symlink_to(outside)
+        self.p['claim']['artifact'] = 'escape'
+        self.refuse('path')
+
+    def test_duplicate_json_keys_refuse(self):
+        path = self.save()
+        path.write_bytes(b'{"schema_version":"1.0.0","schema_version":"1.0.0"}')
+        with self.assertRaisesRegex(InitAllocationError, 'duplicate'):
+            load_allocation(path, expected=self.expected, schema_check=check_schema)
+
+    def test_review_digest_rejection_and_self_review_refuse(self):
+        for key, value in [('reviewed_payload_digest', 'sha256:' + '0' * 64), ('decision', 'REJECT'), ('by', 'builder')]:
+            path = self.save()
+            e = json.loads(path.read_bytes())
+            e['review'][key] = value
+            path.write_text(json.dumps(e))
+            with self.assertRaisesRegex(InitAllocationError, 'review'):
+                load_allocation(path, expected=self.expected, schema_check=check_schema)
+
+    def test_unresolved_page_marker_refuses(self):
+        g = self.p['sweep']['surfaces']['comments']['gather']
+        receipt = json.loads((self.root / g['artifact']).read_bytes())
+        receipt['pages'][0]['next'] = 'unread/page'
+        a, d = self.put(g['artifact'], receipt)
