+        require(registry['repositories'][receipt['repository']]['work_package'] == wp_id, 'registry WP differs')
+        patterns = list(INSTANCE_INTEGRITY) + (['AGENTS.md'] if 'AGENTS.md' in target else [])
+        require(target[LOCKFILE] == _virtual_init_lock(target_root, patterns, target), 'instance lockfile mismatch')
