+WORKER = r'''
+import json, pathlib, sys, uuid
+from scripts import badf_init_allocation as api
+from tests.test_badf_init_reservation import allocation
+framework,target,wp,ready,repository=sys.argv[1:]
+pathlib.Path(ready).write_text('ready')
+sys.stdin.readline()
+try:
+    token=str(uuid.uuid4())
+    with api.acquire_init_locks(pathlib.Path(framework),pathlib.Path(target),token=token):
+        r=api.reserve_init(pathlib.Path(framework),pathlib.Path(target),allocation(wp,repository),token=token,expected_effects=[])
+        print('WIN',flush=True)
+except api.InitAllocationError:
+    print('LOSE',flush=True)
+'''
