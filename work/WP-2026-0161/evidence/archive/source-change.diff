+"""Synthetic consistency fixture; never authorization or channel authentication.
+
+Retained page artifacts are exact source-surface text. Dumps equal the ordered
+page bytes joined by one LF (b'\\n'.join(pages)); a single page equals the dump.
+Fixture surfaces initially each have one page. Multi-page test helpers preserve
+separate page artifacts, update the aggregate/report, and review the new payload.
+"""
+import hashlib,json
+from pathlib import Path
+from scripts import badf_id_sweep as sweep
+
+def digest(b): return 'sha256:'+hashlib.sha256(b).hexdigest()
+def canonical(v): return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()
+def fixture(root, *, work_package="WP-2026-0161"):
+    def put(name,value):
