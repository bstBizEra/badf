+        require(project['project']['repository'] == receipt['repository'] == wp['repository'], 'repository bindings disagree')
+        require(project['badf']['framework_revision'] == receipt['framework_revision'], 'framework revision disagrees')
+        expected_state = derive_state(project['project']['id'], receipt['framework_revision'], wp_id,
+                                      project['delivery']['target'], state['entrypoint'], receipt['baseline_commit'], bindings['_receipt'])
+        require(state == expected_state, 'derived state mismatch')
+        require(dossier['disposition'] == 'HUMAN_REQUIRED' and not dossier['approvals'], 'G00 must stay unsigned and held')
+        require(wp['status'] == 'DRAFT' and all(wp[k] == 'DECLARED_MISSING' for k in JUDGMENT_FIELDS), 'intake judgment invented')
+        generated = {p['path']: p['digest'] for p in receipt['generated']}
+        require(len(generated) == len(receipt['generated']), 'duplicate generated receipt paths')
+        require(generated == {rel: _digest_bytes(data) for rel, data in target.items()
+                              if rel not in (LOCKFILE, bindings['_receipt'])}, 'generated receipt digest mismatch')
+        if 'AGENTS.md' in target:
