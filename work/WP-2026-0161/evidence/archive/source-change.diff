+    def reserve(self, wp='WP-2026-0161', framework=None, token=None):
+        fw = framework or self.framework
+        tok = token or self.token
+        with api.acquire_init_locks(fw, self.target, token=tok):
+            return api.reserve_init(fw, self.target, allocation(wp), token=tok, expected_effects=[])
+
+    @staticmethod
+    def reap(p):
+        if p.poll() is None: p.kill()
+        p.communicate(timeout=15)
+
+    def race(self, contenders, repositories=None):
+        protected={repo: {p.relative_to(repo):p.read_bytes() for p in repo.rglob('*')
+                          if p.is_file() and '.git' not in p.relative_to(repo).parts}
+                   for fw,target,_ in contenders for repo in (fw,target)}
+        workers=[]
+        for i,(fw,target,wp) in enumerate(contenders):
+            ready=self.root/f'ready-{i}'
+            p=subprocess.Popen([sys.executable,'-c',WORKER,str(fw),str(target),wp,str(ready),(repositories or ['example/target']*len(contenders))[i]],
+                               stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+            workers.append((p,ready))
+            self.addCleanup(self.reap, p)
+        import time
+        deadline=time.monotonic()+15
+        while not all(r.exists() for _,r in workers):
+            if time.monotonic()>deadline:
+                self.fail('subprocess barrier timed out')
+            time.sleep(.01)
+        for p,_ in workers:
+            p.stdin.write('go\n'); p.stdin.flush()
+        results=[]
+        for p,_ in workers:
+            out,err=p.communicate(timeout=15)
+            self.assertEqual(p.returncode,0,err)
+            results.append(out.strip())
+        self.assertEqual(results.count('WIN'),1,results)
+        self.assertEqual(results.count('LOSE'),len(workers)-1,results)
+        # Loser has no authority to write the target namespace or registry bytes.
+        for repo,before in protected.items():
+            self.assertEqual(git(repo,'status','--porcelain'),b'')
+            after={p.relative_to(repo):p.read_bytes() for p in repo.rglob('*')
+                   if p.is_file() and '.git' not in p.relative_to(repo).parts}
+            self.assertEqual(after,before, f'contender worktree/registry changed: {repo}')
+        records=list({p for _,t,_ in contenders for p in api.resolve_common_dir(t).glob('badf-init/intake.json')})
+        self.assertEqual(len(records),1)
+        token=json.loads(records[0].read_text())['token']
+        all_records=[]
+        for fw,_,_ in contenders:
+            all_records.extend(api.resolve_common_dir(fw).glob('badf-init/reservations/*/reservation.json'))
+        self.assertEqual(len({str(p) for p in all_records}),1)
+        self.assertTrue(all(json.loads(p.read_text())['token']==token for p in all_records))
+
