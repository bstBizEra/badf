+def init_execution_inputs() -> list[dict[str, str]]:
+    """Current execution contracts, independent of bundle-supplied manifests.
+
+    Mutable repositories.json and generated aggregate lockfiles are output
+    inputs: reloaded under locks, with before/after bytes checked at commit.
+    They are deliberately not allocation contracts. Unrelated work/docs/tests
+    enter the aggregate lock but do not execute intake or generate its records.
+    """
+    paths = {"scripts/badf_gate.py", "scripts/badf_init_allocation.py", "scripts/badf_id_sweep.py",
+             "badf/lifecycle.json", "badf/authority-matrix.json", "badf/mcp-registry.json",
+             "badf/tool-registry.json", "badf/skill-registry.json"}
+    for pattern in ("schemas/*.json", "templates/*"):
+        paths.update(p.relative_to(ROOT).as_posix() for p in ROOT.glob(pattern) if p.is_file())
+    return [{"path": "framework/" + rel, "digest": sha256(_init_path(ROOT, rel))} for rel in sorted(paths)]
+
+
+def _current_init_bindings(proj: dict[str, Any], work_package: str,
+                           checkout_metadata: dict[str, Any]) -> dict[str, Any]:
+    root = Path(proj["local_path"]).resolve()
+    def git(repo, *args):
+        result = _foreign_git(repo, *args)
+        if result.returncode:
+            raise ValidationError(f"allocation binding: git {' '.join(args)} failed at {repo}")
+        return result.stdout
+    load_demand(proj["demand"])
+    top = git(root, "rev-parse", "--show-toplevel").decode().strip()
+    if Path(top).resolve() != root or root == ROOT.resolve():
+        raise ValidationError("intent.project.local_path must be a repository root other than the BADF framework itself")
+    head = git(root, "rev-parse", "HEAD").decode().strip()
+    revision = git(ROOT, "rev-parse", "HEAD").decode().strip()
+    status = git(root, "status", "--porcelain=v2", "--untracked-files=all")
+    if status:
+        raise ValidationError("target working tree is not clean")
+    agents = _init_path(root, "AGENTS.md")
+    registry = load_json(_init_path(ROOT, REPOSITORIES))
+    repos = registry.get("repositories") if isinstance(registry, dict) else None
+    if not isinstance(repos, dict) or any(not isinstance(spec, dict) for spec in repos.values()):
+        raise ValidationError("init repository registry must contain repository mappings")
+    identities = [name for name, spec in repos.items() if spec.get("resolution") == "SELF"]
+    if identities != ["bstBizEra/badf"]:
+        raise ValidationError("init registry must declare exactly one framework SELF identity")
+    return {
+        "work_package": work_package,
+        "framework": {"repository": identities[0], "revision": revision, "inputs": init_execution_inputs()},
+        "target": {"repository": proj["repository"], "baseline_commit": head,
+                   "status_digest": _digest_bytes(status), "agents_digest": sha256(agents) if agents.is_file() else None},
+        "demand": {"id": proj["demand"], "digest": sha256(ROOT / DEMANDS_DIR / (proj["demand"] + ".json"))},
+        "checkout": {"common_directory": str(resolve_common_dir(ROOT)),
+                     "worktrees_digest": _digest_bytes(git(ROOT, "worktree", "list", "--porcelain")),
+                     # These two fields name retained evidence and its claimed
+                     # acquisition time, not a current locally authenticated capture.
+                     "worktrees_artifact": checkout_metadata["worktrees_artifact"],
+                     "captured_at": checkout_metadata["captured_at"]},
+    }
+
