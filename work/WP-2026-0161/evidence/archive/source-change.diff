+            require_fields(event, LEDGER_FIELDS, 'prepared init ledger')
+            require(type(event['sequence']) is int and event['sequence'] == sequence, 'ledger sequence must be integer')
+            require(event['workflow_id'] == wp_id and event['event_id'] == f'EVT-{wp_id}-{sequence:04d}'
+                    and event['step'] == 'init' and event['effect_id'] == 'intake', 'ledger event identity differs')
+            require(event['actor'] == {'id': 'badf-init', 'type': 'controller'}
+                    and event['recorded_at'] == bindings['_now'], 'ledger actor/time differs')
+            require(event['previous_event_hash'] == previous and event['event_hash'] == _event_hash(event), 'ledger hash mismatch')
+            previous = event['event_hash']
+        _validate_effect_chain(events, 'prepared init ledger')
+        require(events[0]['output_digest'] is None and events[1]['output_digest'] == _digest_bytes(framework[wp_rel+'/work-package.json']), 'ledger output digest mismatch')
+        allocation = bindings['_allocation']
+        if allocation is not None:
+            envelope = document(framework[wp_rel+'/evidence/G00/allocation/allocation.json'])
+            check_schema('init-allocation', envelope)
+            require(_digest_bytes(allocation.record_bytes) == allocation.record_digest
+                    and framework[wp_rel+'/evidence/G00/allocation/allocation.json'] == allocation.record_bytes, 'allocation envelope digest mismatch')
+            require(_digest_bytes(json.dumps(envelope['payload'], sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()) == allocation.payload_digest,
+                    'allocation payload digest mismatch')
