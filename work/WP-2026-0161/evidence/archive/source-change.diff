+def synthetic_init_allocation(framework, intent_path, *, work_package='WP-2026-0888'):
+    """Offline synthetic review only; never a published claim or real authority.
+
+    Commit candidate controllers/schema BEFORE capturing HEAD. Historical tests
+    that do not call this helper retain their original historical pin.
+    """
+    import json
+    from tests._init_allocation import fixture, digest
+    proj = json.loads(intent_path.read_bytes())['project']
+    # Invalid intent/demand/root tests still reach the existing refusal first.
+    if not all(k in proj for k in ('local_path', 'repository', 'demand')):
+        return ['--work-package', work_package, '--allocation', str(framework.parent/'missing-allocation.json')]
+    target = Path(proj['local_path'])
+    demand = framework/'badf/demands'/ (proj['demand']+'.json')
+    if not demand.is_file() or not (target/'.git').exists():
+        return ['--work-package', work_package, '--allocation', str(framework.parent/'missing-allocation.json')]
+    git = lambda repo, *args: subprocess.check_output(['git','-C',str(repo),*args], stderr=subprocess.PIPE)
+    # Copy all three actually executing modules even when source HEAD predates them.
+    for rel in ('scripts/badf_gate.py', 'scripts/badf_init_allocation.py', 'scripts/badf_id_sweep.py'):
+        source = Path(gate.__file__).resolve().parents[1]/rel
+        shutil.copy2(source, framework/rel)
+    git(framework, 'add', 'scripts', 'schemas')
+    staged = git(framework, 'diff', '--cached', '--name-only')
+    if staged:
+        git(framework, '-c','user.name=Synthetic fixture','-c','user.email=fixture@example.invalid',
+            'commit','-qm','Synthetic candidate controller/schema snapshot')
+    bundle = framework.parent / ('allocation-'+work_package)
+    bundle.mkdir(exist_ok=True)
+    p, _, save, _ = fixture(bundle, work_package=work_package)
+    inputs = sorted(set(['scripts/badf_gate.py','scripts/badf_init_allocation.py','scripts/badf_id_sweep.py',
+                         'badf/lifecycle.json','badf/authority-matrix.json','badf/mcp-registry.json',
+                         'badf/tool-registry.json','badf/skill-registry.json'] +
+                        [x.relative_to(framework).as_posix() for pattern in ('schemas/*.json','templates/*')
+                         for x in framework.glob(pattern) if x.is_file()]))
+    p['framework'].update(revision=git(framework,'rev-parse','HEAD').decode().strip(), inputs=[])
+    for rel in inputs:
+        data=(framework/rel).read_bytes(); name='framework/'+rel
+        out=bundle/name;out.parent.mkdir(parents=True,exist_ok=True);out.write_bytes(data)
+        p['framework']['inputs'].append(dict(path=name,digest=digest(data)))
+    p['target'].update(repository=proj['repository'], baseline_commit=git(target,'rev-parse','HEAD').decode().strip(),
+                       status_digest=digest(git(target,'status','--porcelain=v2','--untracked-files=all')),
+                       agents_digest=digest((target/'AGENTS.md').read_bytes()) if (target/'AGENTS.md').is_file() else None)
+    p['demand'].update(id=proj['demand'], digest=digest(demand.read_bytes()))
+    worktrees=git(framework,'worktree','list','--porcelain'); (bundle/'worktrees.txt').write_bytes(worktrees)
+    common=git(framework,'rev-parse','--git-common-dir').decode().strip()
+    p['checkout'].update(common_directory=str((framework/common).resolve()),worktrees_digest=digest(worktrees))
+    return ['--work-package',work_package,'--allocation',str(save())]
