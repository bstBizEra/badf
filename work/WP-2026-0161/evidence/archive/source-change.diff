+        records.append(load_json(path))
+    if (any(r.get("token") != reservation.token or r.get("state") != "RESERVED"
+            or r.get("work_package") != reservation.work_package for r in records)
+            or any(r != records[0] for r in records)):
+        raise ValidationError("init reservation ownership changed; retained")
