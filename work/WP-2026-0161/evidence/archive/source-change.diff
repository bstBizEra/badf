+"""Offline allocation consistency, not authentication or authorization."""
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path, PureWindowsPath
+import re
+import subprocess
+import uuid
+from typing import Any, Callable
+
+from scripts import badf_id_sweep as sweep
+
+
+class InitAllocationError(ValueError):
+    """A closed refusal at the offline allocation boundary."""
+
+
+@dataclass(frozen=True)
+class Allocation:
+    work_package: str
+    record_bytes: bytes
+    record_digest: str
+    payload_digest: str
+    evidence: dict[str, bytes]
+    bindings: dict[str, Any]
+
+
+def _require(ok, label):
+    if not ok:
+        raise InitAllocationError(label)
+
+
+def _digest(data):
+    return 'sha256:' + hashlib.sha256(data).hexdigest()
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        _require(key not in result, f'duplicate key {key}')
+        result[key] = value
+    return result
+
+
+def _object(value, label):
+    _require(isinstance(value, dict), f'{label}: JSON object required')
+    return value
+
+
+def _json(data, label):
+    try:
+        value = json.loads(data.decode('utf-8'), object_pairs_hook=_pairs)
+    except (ValueError, UnicodeError) as exc:
+        raise InitAllocationError(f'{label}: {exc}') from exc
+    return _object(value, label)
+
+
+def _time(value, label):
+    try:
+        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
+        if result.tzinfo is None:
+            raise ValueError('timezone required')
+        return result.astimezone(timezone.utc)
+    except (ValueError, TypeError, AttributeError) as exc:
+        raise InitAllocationError(f'{label}: UTC-aware ISO time required') from exc
+
+
+def _validate_claim(claim, framework_repository, wp, retained):
+    raw = _json(retained(claim['artifact'], claim['digest'], 'claim'), 'claim')
+    user = _object(raw.get('user'), 'claim: user')
+    raw_fields = {
+        'comment_id': raw.get('id'),
+        'account': user.get('login'),
+        'created_at': raw.get('created_at'),
+        'updated_at': raw.get('updated_at'),
+        'url': raw.get('html_url'),
+    }
+    for key, value in raw_fields.items():
+        _require(claim[key] == value, f'claim: raw {key} mismatch')
+    body = raw.get('body')
+    _require(isinstance(body, str), 'claim: body string required')
+    _require(re.search(r'\bCLAIM\s+' + re.escape(wp) + r'\b', body) is not None,
+             'claim: literal CLAIM content absent')
+    acquisition = claim['acquisition']
+    expected_resource = f"repos/{framework_repository}/issues/comments/{claim['comment_id']}"
+    _require(acquisition['operation'] == 'READ'
+             and acquisition['outcome'] == 'PASS'
+             and acquisition['repository'] == framework_repository
+             and acquisition['resource'] == expected_resource,
+             'claim: acquisition attribution mismatch')
+    created = _time(claim['created_at'], 'claim created')
+    updated = _time(claim['updated_at'], 'claim updated')
+    captured = _time(acquisition['captured_at'], 'claim acquisition')
+    _require(created <= updated <= captured, 'claim: chronology mismatch')
+    return captured
+
+
+def _validate_gather(name, surface, surface_bytes, retained):
+    gather = surface['gather']
+    label = name + ' gather'
+    _require(gather['outcome'] == 'PASS' and gather['complete'] is True
+             and bool(gather['pages']), f'{name}: incomplete gather')
+    receipt = _json(retained(gather['artifact'], gather['digest'], label), label)
+    _require(set(receipt) == {'pages', 'complete'} and receipt['complete'] is True,
+             f'{label}: incomplete receipt')
+    pages = receipt['pages']
+    _require(isinstance(pages, list) and len(pages) == len(gather['pages']),
+             f'{label}: truncated page list')
+    completed = _time(gather['completed_at'], name + ' completed')
+    resources = []
+    projection = []
+    for index, value in enumerate(pages):
+        page = _object(value, label + ' page')
+        next_resource = gather['pages'][index + 1] if index + 1 < len(pages) else None
+        _require(set(page) == {'resource', 'outcome', 'next', 'artifact', 'digest', 'captured_at'}
+                 and page['outcome'] == 'PASS' and page['next'] == next_resource,
+                 f'{label}: incomplete page')
+        _require(isinstance(page['resource'], str), f'{label}: page resource string required')
+        resources.append(page['resource'])
+        page_bytes = retained(page['artifact'], page['digest'], name + ' page',
+                              repeat=page['artifact'] == surface['artifact'])
+        projection.append(page_bytes)
+        _require(_time(page['captured_at'], name + ' page') <= completed,
+                 f'{name}: page chronology')
+    _require(resources == gather['pages'] and len(set(resources)) == len(resources),
+             f'{name}: page identities')
+    # Each retained page is exact source-surface text. A single page equals its dump;
+    # multiple ordered pages are joined with one LF, preserving all original bytes.
+    _require(surface_bytes == b'\n'.join(projection),
+             f'{name}: page projection differs from scanned dump')
+    return completed
+
+
+def _validate_review(payload, review, payload_digest, texts, latest, retained):
+    wp = payload['work_package']
+    claim = payload['claim']
+    seats = payload['seats']
+    _require(review['decision'] == 'ACCEPT'
+             and review['by'] != payload['claimant']['principal']
+             and review['reviewed_payload_digest'] == payload_digest,
+             'review: independent payload decision mismatch')
+    decision = _json(retained(review['artifact'], review['digest'], 'review'), 'review')
+    fields = {'by', 'principal_type', 'decision', 'reviewed_payload_digest', 'work_package',
+              'claim', 'roster_complete', 'seats', 'occurrences', 'channel_verification'}
+    _require(set(decision) == fields, 'review: channel evidence fields')
+    channel = dict(outcome='PASS', method='approved-channel-review', claim_url=claim['url'],
+                   account=claim['account'], acquisition_resource=claim['acquisition']['resource'])
+    _require(decision['channel_verification'] == channel,
+             'review: channel verification absent or contradictory')
+    for key in ('by', 'principal_type', 'decision', 'reviewed_payload_digest'):
+        _require(decision[key] == review[key], f'review: {key} contradiction')
+    _require(decision['work_package'] == wp and decision['claim'] == claim
+             and decision['roster_complete'] is True and decision['seats'] == seats,
+             'review: channel/seat reconciliation contradiction')
+    for seat in seats:
+        _require(all(c == wp and seat['principal'] == payload['claimant']['principal']
+                     for c in seat['claims']), 'seats: competing claim')
+    occurrences = [(name, match.start()) for name in ('bodies', 'comments')
+                   for match in re.finditer(r'\b' + re.escape(wp) + r'\b', texts[name])]
+    reviewed = decision['occurrences']
+    _require(isinstance(reviewed, list), 'review: occurrence list required')
+    seen = []
+    own = 0
+    for value in reviewed:
+        item = _object(value, 'review: occurrence')
+        _require(set(item) == {'surface', 'offset', 'disposition'}
+                 and item['surface'] in ('bodies', 'comments')
+                 and type(item['offset']) is int and item['offset'] >= 0
+                 and item['disposition'] in ('MENTION', 'CLAIMANT'),
+                 'review: occurrence unresolved or competing')
+        seen.append((item['surface'], item['offset']))
+        if item['disposition'] == 'CLAIMANT':
+            _require(item['surface'] == 'comments', 'review: claimant source')
+            own += 1
+    _require(sorted(seen) == sorted(occurrences) and len(set(seen)) == len(seen) and own == 1,
+             'review: exact occurrence reconciliation required')
+    _require(max(latest) <= _time(review['decided_at'], 'review decided'),
+             'review: chronology mismatch')
+
+
+def load_allocation(path: Path, *, expected: dict[str, Any],
+                    schema_check: Callable[[str, Any], None]) -> Allocation:
+    """Validate a bundle without writes or network access.
+
+    expected is the exact current work_package/framework/target/demand/checkout
+    payload bindings. Caller derives exhaustive current executing framework.inputs;
+    its bundle paths and current byte hashes must not be taken from caller JSON.
+    Page projection is b'\\n'.join(ordered page bytes); one page is byte-identical.
+    Retained consistency cannot establish authentic remote acquisition or authority.
+    """
+    evidence = {}
+    root = path.parent.resolve()
+
+    def retained(name, digest, label, *, repeat=False):
+        safe = (isinstance(name, str) and name and '\\' not in name and ':' not in name
+                and not name.startswith('/')
+                and all(part not in ('..', '.', '') for part in name.split('/')))
+        _require(safe, f'{label}: unsafe path')
+        target = root / name
+        _require(target.resolve().is_relative_to(root), f'{label}: path escape')
+        _require(repeat or name not in evidence, f'{label}: duplicate path {name}')
+        try:
+            data = target.read_bytes()
+        except OSError as exc:
+            raise InitAllocationError(f'{label}: unreadable {name}: {exc}') from exc
+        _require(_digest(data) == digest, f'{label}: digest mismatch')
+        evidence[name] = data
+        return data
+
+    try:
+        record_bytes = path.read_bytes()
+        envelope = _json(record_bytes, 'allocation')
+        try:
+            schema_check('init-allocation', envelope)
+        except Exception as exc:
+            raise InitAllocationError(f'allocation schema: {exc}') from exc
+        payload = envelope['payload']
+        wp = payload['work_package']
+        _require(wp[-4:] not in sweep.SENTINELS, 'work_package: excluded sentinel')
+        binding_keys = {'work_package', 'framework', 'target', 'demand', 'checkout'}
+        _require(set(expected) == binding_keys, 'expected: incomplete current bindings')
+        for key in expected:
+            _require(payload[key] == expected[key], f'{key}: current binding mismatch')
+        for item in payload['framework']['inputs']:
+            retained(item['path'], item['digest'], 'framework input')
+        captured = _validate_claim(payload['claim'], payload['framework']['repository'], wp, retained)
+        texts = {}
+        readability = {}
+        latest = [captured]
+        for name, surface in payload['sweep']['surfaces'].items():
+            data = retained(surface['artifact'], surface['digest'], name)
+            text, reason = sweep.read_surface(root / surface['artifact'])
+            _require(text is not None, f'{name}: unreadable surface {reason}')
+            texts[name] = text
+            latest.append(_validate_gather(name, surface, data, retained))
+            count = sum(len(rx.findall(text)) for rx in sweep.FAMILIES.values())
+            readability[name] = f'READ ({count} id occurrence(s))'
+        scanned = sweep.scan(texts)
+        _require(not sweep.positive_control(scanned), 'sweep: missing anchor')
+        for name in sweep.CLAIM_SURFACES:
+            _require(wp[-4:] not in sweep.FAMILIES['WP-2026'].findall(texts[name]),
+                     f'{name}: candidate collision')
+        expected_report = (sweep.render(scanned, readability) + '\n').encode()
+        actual_report = retained(payload['sweep']['report'], payload['sweep']['report_digest'],
+                                 'sweep report')
+        _require(actual_report == expected_report, 'sweep report: bytes mismatch')
+        sweep_time = _time(payload['sweep']['captured_at'], 'sweep capture')
+        _require(max(latest) <= sweep_time, 'sweep: acquisition chronology')
+        checkout = payload['checkout']
+        inventory = retained(checkout['worktrees_artifact'], checkout['worktrees_digest'], 'checkout')
+        _require(inventory.decode('utf-8').startswith('worktree ') and inventory.endswith(b'\n\n'),
+                 'checkout: incomplete worktree inventory')
+        latest.extend([sweep_time, _time(checkout['captured_at'], 'checkout capture')])
+        seats = payload['seats']
+        _require(len({s['principal'] for s in seats}) == len(seats), 'seats: duplicate principal')
+        for seat in seats:
+            response = _json(retained(seat['response_artifact'], seat['response_digest'],
+                                      'seat ' + seat['principal']), 'seat response')
+            _require(response == {k: seat[k] for k in ('principal', 'principal_type', 'claims')},
+                     'seat: response mismatch')
+        payload_digest = _digest(json.dumps(payload, sort_keys=True, separators=(',', ':'),
+                                            ensure_ascii=False).encode())
+        _validate_review(payload, envelope['review'], payload_digest, texts, latest, retained)
+        for term in ('independent clones', 'remote freshness', 'acquisition trust', 'authorization'):
+            _require(any(term in value.lower() for value in payload['non_coverage']),
+                     f'non_coverage: missing {term}')
+        return Allocation(wp, record_bytes, _digest(record_bytes), payload_digest, evidence,
+                          {key: payload[key] for key in expected})
+    except InitAllocationError:
+        raise
+    except (OSError, KeyError, TypeError, ValueError, UnicodeError) as exc:
+        raise InitAllocationError(f'allocation: {exc}') from exc
+
+
+# Cooperative local-process coordination. PID/time never establish ownership or expiry.
+def _now():
+    return datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
+
+
+def _token(value):
+    try:
+        _require(str(uuid.UUID(value)) == value, 'canonical UUID token required')
+    except (ValueError, TypeError, AttributeError) as exc:
+        raise InitAllocationError('canonical UUID token required') from exc
+
+
+def _wp(value):
+    _require(isinstance(value, str) and re.fullmatch(r'WP-2026-[0-9]{4}', value)
+             and value[-4:] not in {'0997', '0998', '0999', '9999'}, 'invalid work package')
+
+
+def _common_dir_path(repo, output, *, windows=False):
+    cls = PureWindowsPath if windows else Path
+    path = cls(output)
+    return path if path.is_absolute() else cls(repo) / path
+
+
+def resolve_common_dir(repo: Path) -> Path:
+    """Resolve Git's checked common directory, including relative worktree output."""
+    try:
+        repo = Path(repo).resolve(strict=True)
+        result = subprocess.run(['git', '-C', str(repo), 'rev-parse', '--git-common-dir'],
+                                capture_output=True, check=True)
+        raw = result.stdout.decode('utf-8').rstrip('\r\n')
+        _require(bool(raw) and '\n' not in raw and '\r' not in raw, 'invalid Git common directory')
+        path = Path(_common_dir_path(repo, raw, windows=os.name == 'nt')).resolve(strict=True)
+        _require(path.is_dir(), 'Git common directory is not a directory')
+        return path
+    except (OSError, subprocess.SubprocessError, UnicodeError) as exc:
+        raise InitAllocationError(f'Git common directory: {exc}') from exc
+
+
+def _safe(path):
+    """Refuse symlinked metadata components, including dangling links."""
+    for component in (path, *path.parents):
+        _require(not component.is_symlink(), f'symlinked metadata: {component}')
+
+
+def _directory(path):
+    _safe(path)
+    path.mkdir(parents=True, exist_ok=True)
+    _require(path.is_dir(), f'metadata directory required: {path}')
+
+
+def _encode(value):
+    return (json.dumps(value, sort_keys=True, ensure_ascii=False, indent=2) + '\n').encode('utf-8')
+
+
+def _exclusive_json(path, value):
+    _safe(path)
+    with path.open('xb') as stream:
+        stream.write(_encode(value))
+        stream.flush()
+
+
+def _read_record(path):
+    _safe(path)
+    return _json(path.read_bytes(), str(path))
+
+
+
+def _record_fields(value, keys, label):
+    _object(value, label)
+    _require(set(value) == set(keys.split()), f'{label}: exact fields required')
+    return value
+
+
+def _record_text(value, label):
+    _require(isinstance(value, str) and bool(value), f'{label}: nonempty string required')
+
+
+def _record_digest(value, label, *, nullable=False, absent=False):
+    if (nullable and value is None) or (absent and value == 'ABSENT'):
+        return
+    _record_text(value, label)
+    _require(re.fullmatch(r'sha256:[0-9a-f]{64}', value), f'{label}: digest required')
+
+
+def _record_binding(value, scope):
+    if scope == 'framework':
+        _record_fields(value, 'repository revision inputs', 'framework binding')
+        _record_text(value['repository'], 'framework repository')
+        _record_text(value['revision'], 'framework revision')
+        _require(re.fullmatch(r'[0-9a-fA-F]{40}', value['revision']), 'framework revision invalid')
+        _require(isinstance(value['inputs'], list) and bool(value['inputs']), 'framework inputs required')
+        for item in value['inputs']:
+            _record_fields(item, 'path digest', 'framework input')
+            _record_text(item['path'], 'framework input path')
+            _record_digest(item['digest'], 'framework input digest')
+    else:
+        _record_fields(value, 'repository baseline_commit status_digest agents_digest', 'target binding')
+        _record_text(value['repository'], 'target repository')
+        _record_text(value['baseline_commit'], 'target baseline')
+        _require(re.fullmatch(r'[0-9a-fA-F]{40}', value['baseline_commit']), 'target baseline invalid')
+        _record_digest(value['status_digest'], 'target status')
+        _record_digest(value['agents_digest'], 'target agents', nullable=True)
+
+
+def _validate_reservation_record(record):
+    """Validate retained shapes before path construction, hashing or observation."""
+    _record_fields(record, 'schema_version token work_package framework target allocation_digest '
+                   'before_snapshot expected_effects observed_effects state created_at updated_at detail non_coverage',
+                   'reservation')
+    _require(record['schema_version'] == '1.0.0', 'reservation version unsupported')
+    _token(record['token'])
+    _wp(record['work_package'])
+    for scope in ('framework', 'target'):
+        root = _record_fields(record[scope], 'path common_directory binding', scope + ' root')
+        for key in ('path', 'common_directory'):
+            _record_text(root[key], scope + ' ' + key)
+            _require(Path(root[key]).is_absolute(), scope + ' root must be absolute')
+        _record_binding(root['binding'], scope)
+    _record_digest(record['allocation_digest'], 'allocation digest')
+    snapshot = _record_fields(record['before_snapshot'], 'work_package framework target demand checkout', 'before snapshot')
+    _require(snapshot['work_package'] == record['work_package'], 'snapshot WP mismatch')
+    for scope in ('framework', 'target'):
+        _record_binding(snapshot[scope], scope)
+        _require(snapshot[scope] == record[scope]['binding'], 'snapshot binding mismatch')
+    demand = _record_fields(snapshot['demand'], 'id digest', 'snapshot demand')
+    _record_text(demand['id'], 'demand ID')
+    _record_digest(demand['digest'], 'demand digest')
+    checkout = _record_fields(snapshot['checkout'], 'common_directory worktrees_artifact worktrees_digest captured_at', 'snapshot checkout')
+    for key in ('common_directory', 'worktrees_artifact'):
+        _record_text(checkout[key], 'checkout ' + key)
+    _record_digest(checkout['worktrees_digest'], 'checkout digest')
+    _time(checkout['captured_at'], 'checkout timestamp')
+    for name in ('expected_effects', 'observed_effects'):
+        _require(isinstance(record[name], list), name + ': array required')
+        for effect in record[name]:
+            expected = name == 'expected_effects'
+            keys = 'path before after' if expected else 'path before after state recorded_at'
+            _record_fields(effect, keys, name + ' entry')
+            _record_text(effect['path'], 'effect path')
+            _record_digest(effect['before'], 'effect before', nullable=not expected, absent=expected)
+            _record_digest(effect['after'], 'effect after')
+            if not expected:
+                _record_text(effect['state'], 'effect state')
+                _require(effect['state'] in {'WRITTEN', 'VERIFIED', 'VALIDATED'}, 'invalid effect state')
+                _time(effect['recorded_at'], 'effect timestamp')
+    _record_text(record['state'], 'reservation state')
+    _require(record['state'] in {'RESERVED', 'HELD', 'COMMITTED'}, 'invalid reservation state')
+    _require(_time(record['created_at'], 'reservation creation') <= _time(record['updated_at'], 'reservation update'),
+             'reservation chronology invalid')
+    _record_text(record['detail'], 'reservation detail')
+    _require(isinstance(record['non_coverage'], list) and bool(record['non_coverage']), 'non-coverage array required')
+    for item in record['non_coverage']:
+        _record_text(item, 'non-coverage entry')
+
+
+def _lock_path(common):
+    return common / 'badf-init' / 'active.lock'
+
+
+def _owned_lock(common, token):
+    lock = _lock_path(common)
+    _safe(lock)
+    owner = _read_record(lock / 'owner.json')
+    _require(owner.get('token') == token, f'lock ownership mismatch: {lock}')
+
+
+@contextmanager
+def acquire_init_locks(framework: Path, target: Path, *, token: str):
+    """Fail immediately; remove only unchanged token-owned, otherwise empty locks."""
+    _token(token)
+    common_dirs = sorted({resolve_common_dir(framework), resolve_common_dir(target)},
+                         key=lambda p: os.path.normcase(str(p)))
+    acquired = []
+    cleanup_errors = []
+    primary_error = None
+    try:
+        for common in common_dirs:
+            lock = _lock_path(common)
+            _directory(lock.parent)
+            _safe(lock)
+            lock.mkdir()  # Exclusive acquisition: an incomplete owner holds too.
+            owner = {'token': token, 'pid': os.getpid(), 'created_at': _now()}
+            _exclusive_json(lock / 'owner.json', owner)
+            acquired.append((lock, _encode(owner)))
+        yield
+    except BaseException as exc:
+        primary_error = exc
+        if isinstance(exc, OSError):
+            raise InitAllocationError(f'init lock: {exc}') from exc
+        raise
+    finally:
+        for lock, original in reversed(acquired):
+            try:
+                _safe(lock)
+                _require({p.name for p in lock.iterdir()} == {'owner.json'},
+                         f'nonempty lock retained: {lock}')
+                owner = lock / 'owner.json'
+                _safe(owner)
+                _require(owner.read_bytes() == original and _read_record(owner).get('token') == token,
+                         f'changed lock owner retained: {lock}')
+                owner.unlink()
+                lock.rmdir()  # Never recursive cleanup.
+            except (OSError, InitAllocationError) as exc:
+                cleanup_errors.append(str(exc))
+        if cleanup_errors:
+            detail = '; '.join(cleanup_errors)
+            if primary_error is not None:
+                detail = f'{type(primary_error).__name__}: {primary_error}; lock cleanup: {detail}'
+            raise InitAllocationError(detail) from primary_error
+
+
+@dataclass(frozen=True)
+class Reservation:
+    token: str
+    work_package: str
+    framework: Path
+    target: Path
+    record_paths: tuple[Path, ...]
+
+
+def reserve_init(framework: Path, target: Path, allocation: Allocation, *, token: str,
+                 expected_effects: list[dict[str, str]]) -> Reservation:
+    """Exclusively retain target index before any target effect or framework reservation."""
+    try:
+        _token(token)
+        _wp(allocation.work_package)
+        framework, target = Path(framework).resolve(strict=True), Path(target).resolve(strict=True)
+        fw_common, target_common = resolve_common_dir(framework), resolve_common_dir(target)
+        for common in {fw_common, target_common}:
+            _owned_lock(common, token)
+        repository = allocation.bindings['target']['repository']
+        _require(isinstance(repository, str) and bool(repository), 'target repository required')
+        _require(allocation.bindings['work_package'] == allocation.work_package, 'WP binding mismatch')
+        for effect in expected_effects:
+            _require(set(effect) == {'path', 'before', 'after'}, 'expected effect keys required')
+            _effect_path(framework, target, effect['path'])
+            _require(effect['before'] == 'ABSENT' or re.fullmatch(r'sha256:[0-9a-f]{64}', effect['before']), 'invalid expected before digest')
+            _require(re.fullmatch(r'sha256:[0-9a-f]{64}', effect['after']), 'invalid expected after digest')
+        base = fw_common / 'badf-init'
+        wp_dir = base / 'reservations' / allocation.work_package
+        target_dir = base / 'targets' / hashlib.sha256(repository.encode('utf-8')).hexdigest()
+        index = target_common / 'badf-init' / 'intake.json'
+        for path in (wp_dir, target_dir, index):
+            _safe(path)
+            _require(not path.exists(), f'existing reservation holds: {path}')
+        for path in (wp_dir.parent, target_dir.parent):
+            _directory(path)
+        paths = (wp_dir / 'reservation.json', target_dir / 'reservation.json', index)
+        now = _now()
+        record = {
+            'schema_version': '1.0.0', 'token': token, 'work_package': allocation.work_package,
+            'framework': {'path': str(framework), 'common_directory': str(fw_common),
+                          'binding': allocation.bindings['framework']},
+            'target': {'path': str(target), 'common_directory': str(target_common),
+                       'binding': allocation.bindings['target']},
+            'allocation_digest': allocation.record_digest,
+            'before_snapshot': dict(allocation.bindings),
+            'expected_effects': expected_effects, 'observed_effects': [], 'state': 'RESERVED',
+            'created_at': now, 'updated_at': now, 'detail': 'Reserved before target writes',
+            'non_coverage': ['Cooperating init invocations only; unrelated tools can ignore locks.',
+                             'Local process interruption retention; hardware power loss is not covered.',
+                             'Windows runtime behavior requires actual Windows verification.']}
+        # Each exclusive path persists even if a subsequent operation fails.
+        _exclusive_json(index, record)
+        wp_dir.mkdir()
+        _exclusive_json(paths[0], record)
+        target_dir.mkdir()
+        _exclusive_json(paths[1], record)
+        return Reservation(token, allocation.work_package, framework, target, paths)
+    except InitAllocationError:
+        raise
+    except (OSError, KeyError, TypeError, ValueError) as exc:
+        raise InitAllocationError(f'init reservation: {exc}') from exc
+
+
+def _effect_path(framework, target, value):
+    from pathlib import PurePosixPath
+    _require(isinstance(value, str) and ':' in value, 'effect path root prefix required')
+    scope, value = value.split(':', 1)
+    _require(scope in {'framework', 'target'}, 'invalid effect root prefix')
+    root = framework if scope == 'framework' else target
+    _require(bool(value) and '\\' not in value and not PureWindowsPath(value).drive,
+             'effect path must be bundle-relative POSIX')
+    path = PurePosixPath(value)
+    _require(not path.is_absolute() and '..' not in path.parts and value != '.', 'unsafe effect path')
+    result = root.joinpath(*path.parts)
+    _safe(result)
+    _require(result.resolve().is_relative_to(root.resolve()), 'effect path escape')
+    return result
+
+
+@contextmanager
+def _reservation_locks(reservation):
+    common = {resolve_common_dir(reservation.framework), resolve_common_dir(reservation.target)}
+    if all(_lock_path(p).exists() for p in common):
+        for p in common:
+            _owned_lock(p, reservation.token)
+        yield
+    else:
+        with acquire_init_locks(reservation.framework, reservation.target, token=reservation.token):
+            yield
+
+
+def _update_reservation(reservation, mutate):
+    try:
+        with _reservation_locks(reservation):
+            records = [_read_record(p) for p in reservation.record_paths]
+            for record in records:
+                _validate_reservation_record(record)
+                _require(record.get('token') == reservation.token
+                         and record.get('work_package') == reservation.work_package,
+                         'reservation ownership changed; retained')
+            _require(all(r == records[0] for r in records), 'reservation journal drift; retained')
+            original = records[0]
+            record = json.loads(json.dumps(original))
+            mutate(record)
+            record['updated_at'] = _now()
+            for path in reservation.record_paths:
+                _safe(path)
+                temporary = path.parent / ('.journal-' + str(uuid.uuid4()))
+                _exclusive_json(temporary, record)
+                # Check ownership immediately before replacing known invocation metadata.
+                _require(_read_record(path) == original,
+                         'reservation ownership changed; retained')
+                os.replace(temporary, path)
+    except InitAllocationError:
+        raise
+    except (OSError, KeyError, TypeError, ValueError) as exc:
+        raise InitAllocationError(f'reservation journal: {exc}') from exc
+
+
+def record_effect(reservation: Reservation, *, path: str, before: str | None,
+                  after: str, state: str) -> None:
+    """Retain an observed effect only after checking its actual bytes."""
+    try:
+        _require(state in {'WRITTEN', 'VERIFIED', 'VALIDATED'}, 'invalid observed effect state')
+        _require(before is None or re.fullmatch(r'sha256:[0-9a-f]{64}', before), 'invalid before digest')
+        def append(record):
+            _require(record['state'] == 'RESERVED', 'terminal reservation cannot journal effects')
+            actual = _digest(_effect_path(reservation.framework, reservation.target, path).read_bytes())
+            _require(actual == after, 'effect bytes differ from claimed digest')
+            record['observed_effects'].append({'path': path, 'before': before, 'after': after,
+                                              'state': state, 'recorded_at': _now()})
+        _update_reservation(reservation, append)
+    except (OSError, TypeError, ValueError) as exc:
+        raise InitAllocationError(f'effect observation: {exc}') from exc
+
+
+def finish_reservation(reservation: Reservation, *, state: str, detail: str) -> None:
+    _require(state in {'COMMITTED', 'HELD'}, 'invalid final reservation state')
+    _require(isinstance(detail, str) and bool(detail), 'reservation detail required')
+    def finish(record):
+        _require(record['state'] == 'RESERVED', 'terminal reservation cannot be relabeled')
+        record['state'], record['detail'] = state, detail
+    _update_reservation(reservation, finish)
+
+
+def inspect_recovery(framework: Path, work_package: str) -> dict[str, Any]:
+    """Read-only diagnostics; even a complete journal grants no recovery authority."""
+    _wp(work_package)
+    fw_common = resolve_common_dir(framework)
+    path = fw_common / 'badf-init' / 'reservations' / work_package / 'reservation.json'
+    report = {'disposition': 'HUMAN_REQUIRED', 'work_package': work_package, 'state': 'HELD',
+              'manual_review': [
+                  'Verify the token, allocation, root bindings, owners and every linked record before trusting effects.',
+                  'Compare expected, journaled and actual bytes; preserve foreign edits and incomplete journals.',
+                  'Any abandonment or completion requires an independently authorized bounded action; '
+                  'this report does not release the published claim or approve G00.'],
+              'non_coverage': ['Read-only observations are not an atomic snapshot; concurrent changes can occur.',
+                               'Local process interruption retention does not establish hardware power-loss durability.']}
+    try:
+        record = _read_record(path)
+        _validate_reservation_record(record)
+        _require(record['work_package'] == work_package, 'recovery WP binding mismatch')
+        initiating = Path(record['framework']['path']).resolve(strict=True)
+        target = Path(record['target']['path']).resolve(strict=True)
+        _require(resolve_common_dir(initiating) == fw_common
+                 and record['framework']['common_directory'] == str(fw_common),
+                 'recovery framework root mismatch')
+        target_common = resolve_common_dir(target)
+        _require(record['target']['common_directory'] == str(target_common),
+                 'recovery target root mismatch')
+        report.update({'token': record['token'], 'recorded_state': record['state'],
+                       'framework': record['framework'], 'target': record['target'],
+                       'allocation_digest': record['allocation_digest'], 'detail': record['detail'],
+                       'before_snapshot': record['before_snapshot'],
+                       'expected_effects': [], 'observed_effects': [], 'linkage_errors': [],
+                       'retained_records': [], 'owners': []})
+        for common in sorted({fw_common, target_common}, key=str):
+            owner_path = _lock_path(common) / 'owner.json'
+            try:
+                report['owners'].append({'path': str(owner_path), 'owner': _read_record(owner_path)})
+            except (OSError, InitAllocationError) as exc:
+                report['owners'].append({'path': str(owner_path), 'error': str(exc)})
+        repository = record['target']['binding']['repository']
+        linked = [path,
+                  fw_common / 'badf-init' / 'targets' / hashlib.sha256(repository.encode('utf-8')).hexdigest() / 'reservation.json',
+                  target_common / 'badf-init' / 'intake.json']
+        for linked_path in linked:
+            retained = {'path': str(linked_path)}
+            try:
+                _safe(linked_path)
+                raw = linked_path.read_bytes()
+                retained['digest'] = _digest(raw)
+                other = _json(raw, str(linked_path))
+                _validate_reservation_record(other)
+                retained.update({key: other[key] for key in ('token', 'state', 'detail')})
+                retained['observed_effect_count'] = len(other['observed_effects'])
+                _require(other == record, 'reservation metadata drift')
+            except (OSError, InitAllocationError) as exc:
+                retained['error'] = str(exc)
+                report['linkage_errors'].append({'path': str(linked_path), 'error': str(exc)})
+            report['retained_records'].append(retained)
+        if report['linkage_errors']:
+            # Owners and retained record digests remain useful, but uncorroborated
+            # roots/indexes must never authorize effect reads.
+            return report
+        report['state'] = 'HELD' if record['state'] == 'RESERVED' else record['state']
+        for name in ('expected_effects', 'observed_effects'):
+            for effect in record[name]:
+                observed = dict(effect)
+                try:
+                    observed['actual'] = _digest(_effect_path(initiating, target, effect['path']).read_bytes())
+                    observed['status'] = ('APPLIED' if observed['actual'] == effect['after'] else
+                                          'NOT_APPLIED' if observed['actual'] == effect['before'] else 'MISMATCH')
+                except FileNotFoundError:
+                    observed['actual'] = None
+                    observed['status'] = 'NOT_APPLIED' if effect['before'] in (None, 'ABSENT') else 'MISMATCH'
+                except (OSError, InitAllocationError) as exc:
+                    observed['actual'], observed['error'], observed['status'] = None, str(exc), 'UNREADABLE'
+                if name == 'expected_effects':
+                    observed['journaled'] = any(
+                        item['path'] == effect['path'] and item['after'] == effect['after']
+                        and item['before'] == (None if effect['before'] == 'ABSENT' else effect['before'])
+                        for item in record['observed_effects'])
+                report[name].append(observed)
+        if any(e['status'] != 'APPLIED' or not e['journaled'] for e in report['expected_effects']):
+            report['state'] = 'HELD'
+    except (OSError, KeyError, TypeError, ValueError, InitAllocationError) as exc:
+        report['error'] = str(exc)
+    return report
