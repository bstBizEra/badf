+  "data_classification": "internal",
+  "acceptance_criteria": [
+    "badf-release-validation registered DESIGNED; digest = sha256(SKILL.md); no scripts/badf_release_validation.py, no schema, no lifecycle.json change",
+    "contract test asserts all 20 invariants VAL-I01..I20 by id, the obligation-router workflow, composes-existing-G09-quartet / no fifth type, adapt-not-authority (qa-skills / Grafana k6 / OWASP), and the G08!=G09!=G10!=G12 boundaries",
+    "SKILL.md freezes: routing derives obligations from risk (not run-all-QA); class independence; exact-candidate binding; thresholds pre-exist outcomes; runtime observation with an oracle outside the agent; conjunctive G09 dossier; non-coverage mandatory",
+    "repo integrity clean; compose green both shapes; PyYAML-absent suite green"
+  ],
+  "permissions": [
+    "write: bstBizEra/badf via PR"
+  ],
+  "tests": [
+    "tests/test_badf_release_validation_contract.py"
+  ],
+  "evidence": [
+    "compose output"
+  ],
+  "rollback": {
+    "reversible": true,
