{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/security-composition.schema.json",
  "title": "badf-security-design composition matrix -- one row per material threat/abuse case, binding its provenance, disposition and controls (WP-SEC-B)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "threats"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "architecture_baseline": {"type": "string", "minLength": 1},
    "solution_baseline": {"type": "string", "minLength": 1},
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security_id", "source", "disposition"],
        "properties": {
          "security_id": {"type": "string", "pattern": "^SEC-THR-[0-9]{3,}$"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "architecture_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "solution_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "trust_boundary_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "data_flow_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "disposition": {"type": "string", "enum": ["controlled", "deferred", "blocked", "pending-authority"]},
          "control_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "security_requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verification_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "residual_risk": {"type": "string", "enum": ["UNASSESSED", "MITIGATED", "DEFERRED", "ACCEPTED-PENDING-AUTHORITY"]}
        }
      }
    }
  }
}
