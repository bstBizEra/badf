{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/privacy-assessment.schema.json",
  "title": "G05 privacy-assessment evidence artifact -- data categories with a lawful basis and handling",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "data_categories"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "data_categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "data", "classification", "lawful_basis", "handling"],
        "properties": {
          "id": {"type": "string", "pattern": "^PD-[0-9]{3,}$"},
          "data": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted", "personal", "sensitive"]},
          "lawful_basis": {"type": "string"},
          "handling": {"type": "string"},
          "retention": {"type": "string"}
        }
      }
    }
  }
}
