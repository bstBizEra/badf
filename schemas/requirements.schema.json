{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/requirements.schema.json",
  "title": "G02 requirements evidence artifact -- the decomposed, prioritised, testable requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "priority",
          "testable",
          "objective_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "Must Have",
              "Should Have",
              "Could Have",
              "Won't Have"
            ]
          },
          "testable": {
            "type": "boolean"
          },
          "objective_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OBJ-[0-9]{3,}$"
            }
          }
        }
      }
    }
  }
}
