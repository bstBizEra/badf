{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/threat-model.schema.json",
  "title": "G05 threat-model evidence artifact -- threats and abuse cases, each controlled",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "threats"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "threats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "statement", "mitigation"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]{3,}$"},
          "category": {"type": "string", "enum": ["SPOOFING", "TAMPERING", "REPUDIATION", "INFO_DISCLOSURE", "DENIAL_OF_SERVICE", "ELEVATION_OF_PRIVILEGE", "ABUSE_CASE", "AI_SAFETY"]},
          "statement": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string"},
          "residual_risk": {"type": "string"}
        }
      }
    }
  }
}
