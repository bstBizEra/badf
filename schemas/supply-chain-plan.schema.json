{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/supply-chain-plan.schema.json",
  "title": "G05 supply-chain-plan evidence artifact -- dependency and secret controls",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "dependencies", "secret_controls"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "control"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEP-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "control": {"type": "string"},
          "provenance": {"type": "string"}
        }
      }
    },
    "secret_controls": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
