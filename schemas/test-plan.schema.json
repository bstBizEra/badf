{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/test-plan.schema.json",
  "title": "G06 test-plan -- planned tests, each targeting something",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planned_tests"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "planned_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verifies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PT-[0-9]{3,}$"
          },
          "verifies": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
