{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/architecture.schema.json",
  "title": "G04 architecture evidence artifact -- the canonical architecture baseline (the spine)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "identity",
    "baseline_revision",
    "boundaries",
    "elements",
    "interfaces",
    "relationships",
    "trust_boundaries",
    "data_flows",
    "nfr_allocations",
    "fitness_obligations"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "identity": {"type": "string", "minLength": 1},
    "baseline_revision": {"type": "string", "minLength": 1},
    "upstream_requirements": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}},
    "boundaries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^BND-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["system", "module", "ownership", "control-plane", "trust"]}
        }
      }
    },
    "elements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind", "boundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["system", "container", "component"]},
          "boundary": {"type": "string", "pattern": "^BND-[0-9]{3,}$"},
          "technology": {"type": "string"}
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "provider"],
        "properties": {
          "id": {"type": "string", "pattern": "^IF-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "pattern": "^EL-[0-9]{3,}$"}
        }
      }
    },
    "relationships": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "intent", "direction", "interaction_type", "protocol", "data_or_command", "trust_boundary_crossing", "criticality"],
        "properties": {
          "from": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "to": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "intent": {"type": "string"},
          "direction": {"type": "string", "enum": ["inbound", "outbound", "bidirectional"]},
          "interaction_type": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1},
          "data_or_command": {"type": "string", "enum": ["data", "command", "event"]},
          "trust_boundary_crossing": {"type": "boolean"},
          "criticality": {"type": "string", "enum": ["low", "medium", "high"]},
          "via_interface": {"type": "string", "pattern": "^IF-[0-9]{3,}$"}
        }
      }
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^TB-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "destination", "trust_boundary_crossing", "purpose", "protocol"],
        "properties": {
          "id": {"type": "string", "pattern": "^DF-[0-9]{3,}$"},
          "source": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "destination": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "trust_boundary_crossing": {"type": "boolean"},
          "data_classification": {"type": "string"},
          "purpose": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1}
        }
      }
    },
    "nfr_allocations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["nfr", "disposition"],
        "properties": {
          "nfr": {"type": "string", "pattern": "^NFR-[0-9]{3,}$"},
          "disposition": {"type": "string", "enum": ["ALLOCATED", "DEFERRED_WITH_REASON", "NOT_APPLICABLE_WITH_REASON"]},
          "element": {"type": "string", "pattern": "^EL-[0-9]{3,}$"},
          "mechanism": {"type": "string"},
          "fitness_obligation": {"type": "string", "pattern": "^FIT-[0-9]{3,}$"},
          "reason": {"type": "string"}
        }
      }
    },
    "fitness_obligations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "property", "scope"],
        "properties": {
          "id": {"type": "string", "pattern": "^FIT-[0-9]{3,}$"},
          "type": {"type": "string", "enum": ["STRUCTURAL", "DEPENDENCY", "BOUNDARY", "CONTRACT", "SECURITY_BOUNDARY", "DATA", "OPERABILITY", "PERFORMANCE", "RESILIENCE", "COST"]},
          "property": {"type": "string"},
          "scope": {"type": "string"},
          "evaluation": {"type": "string"}
        }
      }
    },
    "adr_refs": {"type": "array", "items": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"}},
    "c4_views": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["level", "elements"],
        "properties": {
          "level": {"type": "string", "enum": ["context", "container", "component", "code"]},
          "elements": {"type": "array", "items": {"type": "string", "pattern": "^EL-[0-9]{3,}$"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "non_coverage": {"type": "array", "items": {"type": "string"}}
  }
}
