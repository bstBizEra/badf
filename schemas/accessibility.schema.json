{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/accessibility.schema.json",
  "title": "G03 accessibility evidence artifact -- a declared standard and enumerated criteria",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "standard",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A11Y-[0-9]{3,}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "not_applicable"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
