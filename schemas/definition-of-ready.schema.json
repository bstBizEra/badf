{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/definition-of-ready.schema.json",
  "title": "G02 definition-of-ready evidence artifact -- a human sign-off that every G02 exit criterion is met",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "checklist"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "met"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "met": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
