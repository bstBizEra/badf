{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch-envelope.schema.json",
  "title": "BADF dispatch envelope (AET-B S2, BADF-WP-0159)",
  "description": "One bounded piece of a work package handed to one seat, recorded at work/<WP>/dispatch/<id>.json with its brief beside it. It may only narrow the work package. Code-side enforcement is check_dispatch_envelope and dispatch_check in scripts/badf_gate.py; this schema is its structural backstop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_package_id",
    "seat",
    "base_sha",
    "allowed_paths",
    "allowed_tools",
    "budget",
    "stop_conditions",
    "required_evidence",
    "review",
    "brief",
    "issued_by_run_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^DSP-[0-9]{2,}$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[0-9]{4}-[0-9]{4}$"
    },
    "seat": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\S(.*\\S)?$"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\S(.*\\S)?$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer"
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "enum": [
          "AUTHORITY_CONFLICT",
          "BASELINE_STALE",
          "CREDENTIAL_EXPOSURE",
          "UNEXPECTED_DESTRUCTIVE_SCOPE",
          "POLICY_BYPASS",
          "EVIDENCE_CORRUPTION",
          "BUDGET_EXHAUSTED",
          "PRODUCTION_INSTABILITY"
        ]
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\S(.*\\S)?$"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewer_seat": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "issued_by_run_id": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
