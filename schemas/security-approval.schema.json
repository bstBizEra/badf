{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/security-approval.schema.json",
  "title": "G05 security-approval evidence artifact -- a human security authority owns the residual risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "threat_model_digest", "approved_by", "residual_risk_owner", "decision", "approved_at"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "threat_model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approved_by": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "principal_type", "role"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "principal_type": {"type": "string", "enum": ["human"]},
        "role": {"type": "string", "enum": ["security_authority"]}
      }
    },
    "residual_risk_owner": {"type": "string"},
    "decision": {"type": "string", "enum": ["APPROVED"]},
    "approved_at": {"type": "string"},
    "note": {"type": "string"}
  }
}
