{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/work-package.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "owner",
    "objective",
    "business_value",
    "in_scope",
    "out_of_scope",
    "target_gate",
    "change_class",
    "data_classification",
    "acceptance_criteria",
    "permissions",
    "tests",
    "evidence",
    "rollback",
    "status",
    "demand"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "target_gate": {
      "type": "string",
      "pattern": "^G(0[0-9]|1[0-4])$"
    },
    "change_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "APPROVED",
        "CLOSED",
        "SUPERSEDED"
      ]
    },
    "objective": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "business_value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "in_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "out_of_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "acceptance_criteria": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "rollback": {
      "type": "object",
      "required": [
        "reversible",
        "method"
      ],
      "properties": {
        "reversible": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "declared_missing": {
      "type": "array",
      "items": {
        "enum": [
          "objective",
          "business_value",
          "in_scope",
          "out_of_scope",
          "acceptance_criteria"
        ]
      }
    },
    "discovered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "change_class_rationale": {
      "type": "string"
    },
    "data_classification_rationale": {
      "type": "string"
    },
    "intent": {
      "type": "object"
    },
    "initialized_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_target": {
      "type": "object"
    },
    "demand": {
      "type": "string",
      "pattern": "^BADF-DEM-[0-9]{4,}$"
    }
  }
}
