{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/work-package.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "owner",
    "objective",
    "business_value",
    "in_scope",
    "out_of_scope",
    "target_gate",
    "change_class",
    "data_classification",
    "acceptance_criteria",
    "permissions",
    "tests",
    "evidence",
    "rollback",
    "status",
    "demand"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "target_gate": {
      "type": "string",
      "pattern": "^G(0[0-9]|1[0-4])$"
    },
    "change_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "APPROVED",
        "CLOSED",
        "SUPERSEDED"
      ]
    },
    "objective": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "business_value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "in_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "out_of_scope": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "acceptance_criteria": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "const": "DECLARED_MISSING"
        }
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "rollback": {
      "type": "object",
      "required": [
        "reversible",
        "method"
      ],
      "properties": {
        "reversible": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "declared_missing": {
      "type": "array",
      "items": {
        "enum": [
          "objective",
          "business_value",
          "in_scope",
          "out_of_scope",
          "acceptance_criteria"
        ]
      }
    },
    "discovered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "change_class_rationale": {
      "type": "string"
    },
    "data_classification_rationale": {
      "type": "string"
    },
    "intent": {
      "type": "object"
    },
    "initialized_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_target": {
      "type": "object",
      "description": "Where the work lands. For a self work package, landed_as is a CLAIM the gate corroborates against the ledger: the commit must be on first-parent origin/main and carry this record's Work-Package line, and status must then be CLOSED.",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "base_revision": {
          "type": "string"
        },
        "landed_as": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "landed_content_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "composition_verified": {
          "type": "boolean"
        }
      }
    },
    "demand": {
      "type": "string",
      "pattern": "^BADF-DEM-[0-9]{4,}$"
    },
    "landing_not_on_ledger": {
      "type": "string",
      "minLength": 1,
      "description": "Required when status is CLOSED and no commit on the first-parent history of origin/main carries this record's Work-Package line (withdrawn before landing, or landed before the trailer discipline existed). Refused when the ledger does show a landing: that would be a false statement."
    },
    "source_baselines": {
      "type": "object",
      "description": "The exact upstream inputs this WP implements (IMP-I02).",
      "properties": {
        "requirements": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "security": {
          "type": "string"
        }
      }
    },
    "expected_surfaces": {
      "type": "object",
      "description": "What the WP is expected to change (IMP-I08).",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority_requirement": {
      "type": "object",
      "description": "Authority derived from change_class + the matrix (IMP-I07); never a parallel A0/A2 system.",
      "properties": {
        "derived_from": {
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3"
          ]
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Typed edges; blocking is separate from composition/landing order (IMP-I05/I06).",
      "properties": {
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[A-Za-z0-9._-]+$"
          }
        },
        "composition_after": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[A-Za-z0-9._-]+$"
          }
        },
        "requires_artifact": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[A-Za-z0-9._-]+$"
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "test_obligations": {
      "type": "array",
      "description": "Every acceptance claim has a verification obligation (IMP-I09).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "level": {
            "enum": [
              "unit",
              "contract",
              "integration",
              "security",
              "migration",
              "performance",
              "composed-tree"
            ]
          }
        }
      }
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_budget": {
      "type": "object",
      "required": [
        "max_attempts"
      ],
      "description": "Bounded autonomous execution (IMP-I11).",
      "properties": {
        "max_attempts": {
          "type": "integer"
        },
        "max_elapsed_minutes": {
          "type": "number"
        },
        "max_cost": {}
      }
    },
    "stop_conditions": {
      "type": "array",
      "description": "Immediate-halt conditions (IMP-I12).",
      "items": {
        "enum": [
          "AUTHORITY_CONFLICT",
          "BASELINE_STALE",
          "CREDENTIAL_EXPOSURE",
          "UNEXPECTED_DESTRUCTIVE_SCOPE",
          "POLICY_BYPASS",
          "EVIDENCE_CORRUPTION",
          "BUDGET_EXHAUSTED",
          "PRODUCTION_INSTABILITY"
        ]
      }
    },
    "composition": {
      "type": "object",
      "description": "Landing/composition order, separate from execution blockers (IMP-I06).",
      "properties": {
        "landing_order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[A-Za-z0-9._-]+$"
          }
        }
      }
    }
  }
}
