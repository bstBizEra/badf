{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/data-model.schema.json",
  "title": "G04 data-model evidence artifact -- entities, ownership, lifecycle and persistence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "entities"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "entities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "owner_boundary", "lifecycle", "persistence"],
        "properties": {
          "id": {"type": "string", "pattern": "^ENT-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "owner_boundary": {"type": "string", "pattern": "^BND-[0-9]{3,}$"},
          "lifecycle": {"type": "string", "minLength": 1},
          "persistence": {"type": "string", "minLength": 1},
          "classification": {"type": "string"}
        }
      }
    }
  }
}
