{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/charter.schema.json",
  "title": "BADF instance authority charter (badf/authority/charter.json) -- narrows the framework floor, never expands it",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_repository",
    "framework_revision",
    "framework_matrix_digest",
    "change_classes",
    "human_reserved_roles",
    "reserved_actions",
    "rules",
    "generated_by",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "framework_repository": {
      "type": "string"
    },
    "framework_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Must equal the instance's pinned revision; the floor is the framework matrix AT this commit."
    },
    "framework_matrix_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of badf/authority-matrix.json at framework_revision. The charter is bound to that blob."
    },
    "change_classes": {
      "type": "object",
      "description": "Exactly the framework's classes (C0-C3); each required_roles is a SUPERSET of the floor's."
    },
    "human_reserved_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reserved_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "minimum_class"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "minimum_class": {
            "type": "string",
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3"
            ]
          }
        }
      }
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "badf-charter"
      ]
    },
    "generated_at": {
      "type": "string"
    }
  }
}
