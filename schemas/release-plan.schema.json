{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/release-plan.schema.json",
  "title": "G06 release-plan -- environments ready and concrete steps",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environments",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RS-[0-9]{3,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
