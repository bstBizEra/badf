{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badf.bizera.local/schemas/integration-test.schema.json",
  "title": "BADF G08 evidence: integration-test (typed binding, VER-B / BADF-WP-0103)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "work_package_id",
    "gate",
    "claim",
    "evidence_type",
    "producer",
    "source_revision",
    "target",
    "toolchain",
    "operation",
    "started_at",
    "completed_at",
    "outcome",
    "artifact",
    "digest",
    "binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVD-[A-Za-z0-9._-]+$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9._-]+$"
    },
    "gate": {
      "type": "string",
      "pattern": "^G(0[0-9]|1[0-4])$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "integration-test"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "service",
            "controller"
          ]
        }
      }
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "composition": {
      "type": "object"
    },
    "sanitization": {
      "type": "string"
    },
    "binding": {
      "type": "object",
      "required": [
        "target",
        "execution",
        "non_coverage"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "source_revision",
            "expected_content_tree"
          ],
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "expected_content_tree": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": [
            "runtime",
            "command",
            "working_directory",
            "environment",
            "toolchain",
            "fixtures_epoch",
            "seed",
            "started_at",
            "finished_at",
            "exit_code",
            "tests",
            "output_digest"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "working_directory": {
              "type": "string"
            },
            "environment": {
              "type": "object"
            },
            "toolchain": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "fixtures_epoch": {},
            "seed": {},
            "suite_pattern": {
              "type": "string"
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "finished_at": {
              "type": "string",
              "format": "date-time"
            },
            "exit_code": {
              "type": "integer"
            },
            "tests": {
              "type": "object",
              "required": [
                "total",
                "passed",
                "failed",
                "skipped",
                "quarantined"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "passed": {
                  "type": "integer"
                },
                "failed": {
                  "type": "integer"
                },
                "skipped": {
                  "type": "integer"
                },
                "quarantined": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "output_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "non_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface",
              "reason"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
