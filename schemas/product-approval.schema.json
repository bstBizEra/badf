{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/product-approval.schema.json",
  "title": "G01 product-approval evidence artifact -- a human product owner's approval bound by digest to the exact PRD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "prd_digest",
    "approved_by",
    "decision",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "prd_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of the prd artifact bytes this approval covers; a PRD edited after approval invalidates it"
    },
    "approved_by": {
      "type": "object",
      "required": [
        "principal",
        "principal_type",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "human"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "product_owner"
          ]
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED"
      ]
    },
    "approved_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}
