{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/memory.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "statement",
    "classification",
    "sources",
    "scope",
    "owner",
    "created_at",
    "review_after",
    "confidence",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^MEM-[A-Za-z0-9._-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "DECIDED",
        "SUPERSEDED"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "review_after": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  }
}
