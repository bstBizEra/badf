{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/work-breakdown.schema.json",
  "title": "G06 work-breakdown -- bounded tasks with a composition order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WBS-[0-9]{3,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^WBS-[0-9]{3,}$"
            }
          }
        }
      }
    }
  }
}
