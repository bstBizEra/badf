{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/work-breakdown.schema.json",
  "title": "G06 work-breakdown -- bounded tasks with a composition order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WBS-[0-9]{3,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^WBS-[0-9]{3,}$"
            }
          },
          "composition_after": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^WBS-[0-9]{3,}$"
            }
          },
          "change_class": {
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3"
            ]
          },
          "authority_requirement": {
            "type": "object",
            "properties": {
              "required_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "claim": {
                  "type": "string"
                },
                "level": {
                  "enum": [
                    "unit",
                    "contract",
                    "integration",
                    "security",
                    "migration",
                    "performance",
                    "composed-tree"
                  ]
                }
              }
            }
          },
          "evidence_obligations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_budget": {
            "type": "object",
            "properties": {
              "max_attempts": {
                "type": "integer"
              },
              "max_elapsed_minutes": {
                "type": "number"
              },
              "max_cost": {}
            }
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "enum": [
                "AUTHORITY_CONFLICT",
                "BASELINE_STALE",
                "CREDENTIAL_EXPOSURE",
                "UNEXPECTED_DESTRUCTIVE_SCOPE",
                "POLICY_BYPASS",
                "EVIDENCE_CORRUPTION",
                "BUDGET_EXHAUSTED",
                "PRODUCTION_INSTABILITY"
              ]
            }
          },
          "expected_surfaces": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
