{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/ballot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ballot_id", "decision_id", "dossier_id", "round",
    "input_digest", "artifact_binding", "member", "profile_id", "lens",
    "independence_cluster", "conflict_declaration", "verdict",
    "recommended_option", "option_assessments", "findings",
    "blocking_findings", "evidence_refs", "assumptions", "non_coverage",
    "alternative", "falsification_condition", "calibration_domain",
    "conditions", "submitted_at", "ballot_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ballot_id": {"pattern": "^BADF-BAL-[0-9]{4,}$"},
    "decision_id": {"pattern": "^BADF-DGD-[0-9]{4,}$"},
    "dossier_id": {"pattern": "^BADF-DOS-[0-9]{4,}$"},
    "round": {"enum": [1, 5]},
    "input_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "target_ref", "target_base_sha", "source_ref",
        "source_head_sha", "source_tree_sha", "expected_result_tree"
      ],
      "properties": {
        "repository": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "target_ref": {"type": "string"},
        "target_base_sha": {"pattern": "^[0-9a-f]{40}$"},
        "source_ref": {"type": "string"},
        "source_head_sha": {"pattern": "^[0-9a-f]{40}$"},
        "source_tree_sha": {"pattern": "^[0-9a-f]{40}$"},
        "expected_result_tree": {"pattern": "^[0-9a-f]{40}$"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal", "principal_type", "seat_id", "model_provider",
        "model_family", "model_version", "run_id", "context_digest",
        "toolchain_lineage"
      ],
      "properties": {
        "principal": {"type": "string"},
        "principal_type": {"enum": ["human", "agent", "service", "controller"]},
        "seat_id": {"type": "string"},
        "model_provider": {"type": "string"},
        "model_family": {"type": "string"},
        "model_version": {"type": "string"},
        "run_id": {"type": "string"},
        "context_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "toolchain_lineage": {"type": "string"}
      }
    },
    "profile_id": {"type": "string"},
    "lens": {"type": "string"},
    "independence_cluster": {"type": "string"},
    "conflict_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_author", "shared_authoring_run", "material_conflicts"],
      "properties": {
        "is_author": {"type": "boolean"},
        "shared_authoring_run": {"type": "boolean"},
        "material_conflicts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verdict": {
      "enum": [
        "APPROVE", "APPROVE_WITH_CONDITIONS", "REJECT", "ABSTAIN",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "recommended_option": {"type": ["string", "null"]},
    "option_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id", "criteria", "probability_success_bp",
          "probability_regression_bp", "probability_security_failure_bp",
          "probability_operational_failure_bp"
        ],
        "properties": {
          "option_id": {"type": "string"},
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "probability_satisfy_bp"],
              "properties": {
                "criterion_id": {"type": "string"},
                "probability_satisfy_bp": {
                  "type": "integer", "minimum": 0, "maximum": 10000
                }
              }
            }
          },
          "probability_success_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
          "probability_regression_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
          "probability_security_failure_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
          "probability_operational_failure_bp": {"type": "integer", "minimum": 0, "maximum": 10000}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "status", "statement", "evidence_refs"],
        "properties": {
          "finding_id": {"type": "string"},
          "severity": {"enum": ["Critical", "Major", "Minor"]},
          "status": {"enum": ["OPEN", "RESOLVED", "WITHDRAWN", "ACCEPTED_BY_AUTHORITY"]},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "blocking_findings": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "non_coverage": {"type": "array", "items": {"type": "string"}},
    "alternative": {"type": ["string", "null"]},
    "falsification_condition": {"type": "string"},
    "calibration_domain": {"type": "string"},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "submitted_at": {"type": "string", "format": "date-time"},
    "ballot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of canonical ballot bytes with ballot_digest omitted."
    }
  }
}
