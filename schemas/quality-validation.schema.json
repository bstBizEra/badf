{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badf.bizera.local/schemas/quality-validation.schema.json",
  "title": "BADF G09 evidence: quality-validation (typed binding, WP-VAL-B / BADF-WP-0113)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "work_package_id",
    "gate",
    "claim",
    "evidence_type",
    "producer",
    "source_revision",
    "target",
    "toolchain",
    "operation",
    "started_at",
    "completed_at",
    "outcome",
    "artifact",
    "digest",
    "binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVD-[A-Za-z0-9._-]+$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9._-]+$"
    },
    "gate": {
      "type": "string",
      "pattern": "^G(0[0-9]|1[0-4])$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "quality-validation"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "service",
            "controller"
          ]
        }
      }
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sanitization": {
      "type": "string"
    },
    "binding": {
      "type": "object",
      "required": [
        "candidate",
        "risk_hypothesis",
        "method",
        "oracle",
        "runtime",
        "environment",
        "findings",
        "non_coverage",
        "flake_policy",
        "quality_dimensions"
      ],
      "properties": {
        "candidate": {
          "type": "object",
          "required": [
            "source_revision",
            "content_tree",
            "environment_id",
            "policy_epoch"
          ],
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "content_tree": {
              "type": "string",
              "minLength": 1
            },
            "artifact_digests": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "environment_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_epoch": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "risk_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "object",
          "required": [
            "kind",
            "locator",
            "evaluated_by"
          ],
          "properties": {
            "kind": {
              "enum": [
                "DETERMINISTIC_CHECK",
                "SYSTEM_OF_RECORD",
                "EXTERNAL_SERVICE",
                "HUMAN_ADJUDICATION"
              ]
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "evaluated_by": {
              "type": "object",
              "required": [
                "id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "human",
                    "agent",
                    "service",
                    "controller"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": [
            "runtime",
            "approved",
            "started_at",
            "finished_at",
            "output_digest"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "approved": {
              "type": "boolean"
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "finished_at": {
              "type": "string",
              "format": "date-time"
            },
            "exit_code": {
              "type": "integer"
            },
            "output_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": [
            "identity",
            "configuration",
            "toolchain",
            "observed_at",
            "production_equivalence"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "type": "object"
            },
            "fixtures": {
              "type": "object"
            },
            "toolchain": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "production_equivalence": {
              "enum": [
                "PRODUCTION",
                "PRODUCTION_LIKE",
                "NON_PRODUCTION"
              ]
            },
            "material_deviations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "surface",
                  "deviation"
                ],
                "properties": {
                  "surface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deviation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "severity",
              "status",
              "summary"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "BLOCKER",
                  "CRITICAL",
                  "MAJOR",
                  "MINOR",
                  "INFO"
                ]
              },
              "status": {
                "enum": [
                  "OPEN",
                  "RESOLVED",
                  "DEFERRED_WITH_REASON"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "non_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface",
              "reason"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "flake_policy": {
          "type": "object",
          "required": [
            "reruns_permitted",
            "failed_observations_retained"
          ],
          "properties": {
            "reruns_permitted": {
              "type": "integer"
            },
            "failed_observations_retained": {
              "type": "boolean"
            },
            "quarantine_reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "quality_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "result"
            ],
            "properties": {
              "dimension": {
                "enum": [
                  "FUNCTIONAL",
                  "EXPLORATORY",
                  "CROSS_BROWSER",
                  "ACCESSIBILITY",
                  "DATA_MIGRATION",
                  "VISUAL",
                  "AI_EVALUATION",
                  "TRANSACTIONAL_FLOW"
                ]
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INDETERMINATE"
                ]
              },
              "oracle_locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
