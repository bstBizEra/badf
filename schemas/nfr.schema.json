{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/nfr.schema.json",
  "title": "G02 non-functional requirements evidence artifact -- each NFR carries a quantified target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "nfrs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "nfrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "statement",
          "metric",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NFR-[0-9]{3,}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "performance",
              "availability",
              "security",
              "scalability",
              "usability",
              "maintainability",
              "compliance",
              "reliability"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "required": [
              "operator",
              "value",
              "unit"
            ],
            "additionalProperties": false,
            "properties": {
              "operator": {
                "type": "string",
                "enum": [
                  "<",
                  "<=",
                  "=",
                  ">=",
                  ">"
                ]
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
