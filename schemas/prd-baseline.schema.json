{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/prd-baseline.schema.json",
  "title": "BADF G01 PRD Baseline Candidate",
  "type": "object",
  "required": [
    "schema_version", "id", "gate", "product", "overview", "problem",
    "target_users", "value_proposition", "vision", "objectives", "scope",
    "capabilities", "differentiation", "success_metrics", "stakeholders",
    "assumptions", "constraints", "raid", "legal_regulatory_data",
    "acceptance_criteria", "challenge", "baseline", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "gate": {"const": "G01"},
    "product": {
      "type": "object",
      "required": ["name", "type", "stage", "owner", "target_market"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"},
        "stage": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"},
        "target_market": {"$ref": "#/$defs/text"}
      }
    },
    "overview": {"$ref": "#/$defs/text"},
    "problem": {
      "type": "object",
      "required": ["statement", "affected_users", "current_limitations", "business_impact", "why_now"],
      "properties": {
        "statement": {"$ref": "#/$defs/text"}, "affected_users": {"$ref": "#/$defs/nonEmptyStrings"},
        "current_limitations": {"$ref": "#/$defs/nonEmptyStrings"}, "business_impact": {"$ref": "#/$defs/nonEmptyStrings"},
        "why_now": {"$ref": "#/$defs/text"}
      }
    },
    "target_users": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["segment", "role", "needs", "pain_points"],
        "properties": {"segment": {"$ref": "#/$defs/text"}, "role": {"$ref": "#/$defs/text"},
          "needs": {"$ref": "#/$defs/nonEmptyStrings"}, "pain_points": {"$ref": "#/$defs/nonEmptyStrings"}}}
    },
    "value_proposition": {"type": "object", "required": ["statement", "benefits"],
      "properties": {"statement": {"$ref": "#/$defs/text"}, "benefits": {"$ref": "#/$defs/nonEmptyStrings"}}},
    "vision": {"$ref": "#/$defs/text"},
    "objectives": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "statement", "metric_refs"],
        "properties": {"id": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}, "metric_refs": {"$ref": "#/$defs/nonEmptyStrings"}}}},
    "scope": {"type": "object", "required": ["in_scope", "out_of_scope"],
      "properties": {"in_scope": {"$ref": "#/$defs/nonEmptyStrings"}, "out_of_scope": {"$ref": "#/$defs/nonEmptyStrings"}}},
    "capabilities": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "description", "priority"],
        "properties": {"name": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "priority": {"$ref": "#/$defs/text"}}}},
    "differentiation": {"$ref": "#/$defs/nonEmptyStrings"},
    "success_metrics": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "name", "baseline", "target", "measurement"],
        "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "baseline": {"$ref": "#/$defs/text"},
          "target": {"$ref": "#/$defs/text"}, "measurement": {"$ref": "#/$defs/text"}}}},
    "stakeholders": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["role", "accountability"],
        "properties": {"role": {"$ref": "#/$defs/text"}, "accountability": {"$ref": "#/$defs/text"}}}},
    "assumptions": {"$ref": "#/$defs/strings"},
    "constraints": {"$ref": "#/$defs/strings"},
    "raid": {"type": "object", "required": ["risks", "assumptions", "issues", "dependencies"],
      "properties": {"risks": {"$ref": "#/$defs/strings"}, "assumptions": {"$ref": "#/$defs/strings"},
        "issues": {"$ref": "#/$defs/strings"}, "dependencies": {"$ref": "#/$defs/strings"}}},
    "legal_regulatory_data": {"type": "object", "required": ["legal", "regulatory", "data_classification", "privacy"],
      "properties": {"legal": {"$ref": "#/$defs/strings"}, "regulatory": {"$ref": "#/$defs/strings"},
        "data_classification": {"$ref": "#/$defs/text"}, "privacy": {"$ref": "#/$defs/strings"}}},
    "acceptance_criteria": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "statement", "verification"],
        "properties": {"id": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}, "verification": {"$ref": "#/$defs/text"}}}},
    "challenge": {"type": "object", "required": ["method", "sources_consulted", "findings", "unresolved_decisions"],
      "properties": {
        "method": {"$ref": "#/$defs/text"}, "sources_consulted": {"$ref": "#/$defs/strings"},
        "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "finding", "disposition", "evidence"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "severity": {"enum": ["Critical", "Major", "Minor"]},
            "finding": {"$ref": "#/$defs/text"}, "disposition": {"enum": ["RESOLVED", "ACCEPTED_AS_RISK", "BLOCKING"]},
            "evidence": {"$ref": "#/$defs/text"}}}},
        "unresolved_decisions": {"$ref": "#/$defs/strings"}
      }
    },
    "baseline": {"type": "object", "required": ["version", "source_revision", "created_at", "author", "status", "approval"],
      "properties": {
        "version": {"$ref": "#/$defs/text"}, "source_revision": {"$ref": "#/$defs/text"}, "created_at": {"type": "string", "format": "date-time"},
        "author": {"$ref": "#/$defs/text"}, "status": {"enum": ["DRAFT", "CANDIDATE", "APPROVAL_PENDING", "APPROVED", "REJECTED"]},
        "approval": {"type": "object", "required": ["required_role", "state", "approver", "approved_at", "evidence_refs"],
          "properties": {"required_role": {"const": "product_owner"}, "state": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
            "approver": {"type": ["string", "null"]}, "approved_at": {"type": ["string", "null"], "format": "date-time"},
            "evidence_refs": {"$ref": "#/$defs/strings"}}}
      }
    },
    "evidence_refs": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
  }
}
