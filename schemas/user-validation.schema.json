{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/user-validation.schema.json",
  "title": "G03 user-validation evidence artifact -- the design validated with real users",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "method",
    "participants",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "number"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "observation",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UV-[0-9]{3,}$"
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    }
  }
}
