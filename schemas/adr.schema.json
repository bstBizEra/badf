{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/adr.schema.json",
  "title": "G04 adr evidence artifact -- material architecture decision records (ADR-*, not BADF-DEC-*)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "records"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "status", "context", "decision", "decision_drivers", "alternatives", "affected_elements"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"]},
          "context": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "decision_drivers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["option", "rejected_because"],
              "properties": {
                "option": {"type": "string", "minLength": 1},
                "rejected_because": {"type": "string", "minLength": 1}
              }
            }
          },
          "affected_elements": {"type": "array", "items": {"type": "string", "pattern": "^EL-[0-9]{3,}$"}},
          "requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}},
          "nfr_refs": {"type": "array", "items": {"type": "string", "pattern": "^NFR-[0-9]{3,}$"}},
          "supersedes": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"},
          "superseded_by": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"}
        }
      }
    }
  }
}
