{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/api-contract.schema.json",
  "title": "G04 api-contract evidence artifact -- external/internal interface contracts and versioning",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_id", "apis"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "prd_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9._-]+$"},
    "apis": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "interface", "version", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^API-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "pattern": "^IF-[0-9]{3,}$"},
          "version": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["internal", "external"]},
          "operations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
