{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/gate-dossier.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "work_package_id",
    "gate",
    "policy_epoch",
    "source_revision",
    "target",
    "change_class",
    "evidence",
    "approvals",
    "exceptions",
    "risks",
    "disposition",
    "created_at",
    "author",
    "author_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DOS-[A-Za-z0-9._-]+$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9._-]+$"
    },
    "gate": {
      "type": "string",
      "pattern": "^G(0[0-9]|1[0-4])$"
    },
    "policy_epoch": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "change_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "decision",
          "by",
          "revision",
          "policy_epoch",
          "approved_at",
          "principal_type"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "APPROVED",
              "REJECTED",
              "ABSTAIN"
            ]
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "policy_epoch": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "principal_type": {
            "enum": [
              "human",
              "agent",
              "service",
              "controller"
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "disposition": {
      "enum": [
        "PASS",
        "PASS_WITH_CONDITIONS",
        "FAIL",
        "BLOCKED",
        "HUMAN_REQUIRED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "statement",
          "status",
          "severity",
          "blocking_scope",
          "owner",
          "closure_predicate",
          "closure_authority"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^C-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "CLOSED",
              "SUPERSEDED",
              "WAIVED"
            ]
          },
          "severity": {
            "enum": [
              "Critical",
              "Major",
              "Minor"
            ]
          },
          "blocking_scope": {
            "type": "string",
            "pattern": "^(none|G(0[0-9]|1[0-4])(\\s*,\\s*G(0[0-9]|1[0-4]))*)$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "closure_predicate": {
            "type": "string",
            "minLength": 1
          },
          "closure_authority": {
            "type": "string",
            "minLength": 1
          },
          "closed_by": {
            "type": "string"
          },
          "closed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "obligation_posture": {
      "enum": [
        "CLEAR",
        "OPEN_NON_BLOCKING",
        "OPEN_BLOCKING"
      ]
    },
    "rendered_verdict": {
      "enum": [
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "HELD_FOR_CONDITION_CLOSURE",
        "REWORK_REQUIRED",
        "BLOCKED",
        "HUMAN_REQUIRED"
      ]
    },
    "author_type": {
      "enum": [
        "human",
        "agent",
        "service",
        "controller"
      ]
    }
  }
}
