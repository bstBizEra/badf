{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizera.la/badf/schemas/gate-dossier.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "work_package_id", "gate", "policy_epoch", "source_revision", "target", "change_class", "evidence", "approvals", "exceptions", "risks", "disposition", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^DOS-[A-Za-z0-9._-]+$"},
    "work_package_id": {"type": "string", "pattern": "^WP-[A-Za-z0-9._-]+$"},
    "gate": {"type": "string", "pattern": "^G(0[0-9]|1[0-4])$"},
    "policy_epoch": {"type": "string"},
    "source_revision": {"type": "string"},
    "target": {"type": "string"},
    "change_class": {"enum": ["C0", "C1", "C2", "C3"]},
    "evidence": {"type": "array", "minItems": 1},
    "approvals": {"type": "array"},
    "exceptions": {"type": "array"},
    "risks": {"type": "array"},
    "disposition": {"enum": ["PASS", "PASS_WITH_CONDITIONS", "FAIL", "BLOCKED", "HUMAN_REQUIRED"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

