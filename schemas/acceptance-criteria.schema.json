{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "badf/acceptance-criteria.schema.json",
  "title": "G01 acceptance-criteria evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prd_id",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "prd_id": {
      "type": "string",
      "pattern": "^PRD-[A-Za-z0-9._-]+$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "objective_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OBJ-[0-9]{3,}$"
            }
          }
        }
      }
    }
  }
}
