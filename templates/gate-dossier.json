{
  "$schema": "../schemas/gate-dossier.schema.json",
  "schema_version": "1.0.0",
  "id": "DOS-WP-YYYY-NNNN-G00-v1",
  "work_package_id": "WP-YYYY-NNNN",
  "gate": "G00",
  "policy_epoch": "BADF-2026-08-25",
  "source_revision": "full-source-revision",
  "target": "repository-or-environment-identity",
  "change_class": "C1",
  "evidence": [
    {
      "type": "required-type",
      "path": "evidence/path.json"
    }
  ],
  "approvals": [
    {
      "role": "<role-from-badf/authority-matrix.json>",
      "decision": "APPROVED",
      "by": "<principal-id-not-equal-to-author>",
      "revision": "<must-equal-source_revision>",
      "policy_epoch": "<must-equal-policy_epoch>",
      "approved_at": "<ISO-8601-at-or-after-created_at>"
    }
  ],
  "exceptions": [],
  "risks": [
    {
      "id": "R-<n>",
      "severity": "Critical|Major|Minor",
      "statement": "<what could go wrong>"
    }
  ],
  "disposition": "BLOCKED",
  "created_at": "YYYY-MM-DDTHH:MM:SSZ",
  "author": "<principal-id-of-the-author>",
  "conditions": [
    {
      "condition_id": "C-<n>",
      "statement": "<what is still owed>",
      "status": "OPEN",
      "severity": "Critical|Major|Minor",
      "blocking_scope": "<none | G00..G14 | comma list of gate ids>",
      "owner": "<role-from-authority-matrix>",
      "closure_predicate": "<observable test that closes it>",
      "closure_authority": "<role-from-authority-matrix, not the author>"
    }
  ],
  "obligation_posture": "<COMPUTED by the gate from conditions -- do not assert>",
  "rendered_verdict": "<COMPUTED by the gate from disposition x posture -- do not assert>",
  "council": null,
  "council_disposition": "<COMPUTED by the gate from change_class, risks, rollback, data_classification, gate -- do not assert>"
}
